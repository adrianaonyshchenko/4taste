<Window x:Class="FourTaste.WPF.RoomCreatedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кімнату створено"
        Width="460"
        Height="270"
        WindowStartupLocation="CenterOwner"
        Background="#EADCC9"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="16" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="TitleTextBlock"
                   Text="Кімнату успішно створено!"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#4A352F"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <Border Grid.Row="1"
                Background="#D5C4B4"
                CornerRadius="12"
                Padding="12,8"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Код запрошення:"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#7A685D"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         x:Name="InviteCodeTextBox"
                         FontSize="16"
                         FontWeight="Bold"
                         Foreground="#4A352F"
                         Background="Transparent"
                         BorderThickness="0"
                         IsReadOnly="True"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         CaretBrush="#4A352F"/>

                <Button Grid.Column="2"
                        x:Name="CopyButton"
                        Content="Скопіювати"
                        Style="{StaticResource RoundedButtonStyle}"
                        Background="#542E2B"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="13"
                        Height="32"
                        Padding="14,0"
                        Click="CopyButton_Click"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Поділіться цим кодом, щоб інші користувачі могли приєднатися."
                   FontSize="12"
                   Foreground="#7A685D"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,0,18"/>

        <Button Grid.Row="3"
                x:Name="OkButton"
                Content="ОК"
                Style="{StaticResource RoundedButtonStyle}"
                Background="#877063"
                Foreground="White"
                FontWeight="Bold"
                FontSize="14"
                Width="120"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Click="OkButton_Click"/>
    </Grid>
</Window>
