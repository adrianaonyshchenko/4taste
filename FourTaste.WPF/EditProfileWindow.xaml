<Window x:Class="FourTaste.WPF.EditProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Особисті дані" Height="730" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#E3D1BD"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#4A3532"/>
            <Setter Property="CaretBrush" Value="#4A3532"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#4A3532"/>
            <Setter Property="CaretBrush" Value="#4A3532"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхня панель навігації -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Content="← Назад до профілю"
                    HorizontalAlignment="Left"
                    Height="38"
                    Padding="16,0"
                    Background="#4A3532"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    BorderBrush="Transparent"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Центральна картка налаштувань -->
        <Border Grid.Row="1"
                Background="#C4B4A4"
                CornerRadius="22"
                Width="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Padding="35,22">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Особисті дані та безпека"
                               Foreground="#4A3532"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <!-- Блок зміни аватарки -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Grid Width="84" Height="84" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Border x:Name="DefaultAvatarBorder" Width="84" Height="84" CornerRadius="42" Background="#EBB832">
                                <TextBlock Text="Мій&#10;профіль" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Foreground="#4A3532"/>
                            </Border>
                            <Border x:Name="CustomAvatarBorder" Width="84" Height="84" CornerRadius="42" Visibility="Collapsed">
                                <Border.Background>
                                    <ImageBrush x:Name="AvatarImageBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="ChooseAvatarButton"
                                    Click="ChooseAvatarButton_Click"
                                    Content="Змінити фото"
                                    Height="32"
                                    Padding="14,0"
                                    Background="#4A3532"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="12"
                                    BorderBrush="Transparent"
                                    Cursor="Hand"
                                    Margin="0,0,8,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="12"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="DeleteAvatarButton"
                                    Click="DeleteAvatarButton_Click"
                                    Content="Видалити"
                                    Height="32"
                                    Padding="14,0"
                                    Background="#D8B5A8"
                                    Foreground="#D9534F"
                                    FontWeight="Bold"
                                    FontSize="12"
                                    BorderBrush="Transparent"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="12"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Розділ особистих даних -->
                    <TextBlock Text="Ім'я" Foreground="#4A3532" FontSize="13" FontWeight="SemiBold" Margin="4,0,0,4"/>
                    <Border Background="#E3D1BD" CornerRadius="14" Height="38" Padding="12,0" Margin="0,0,0,10">
                        <TextBox x:Name="ProfileNameTextBox"/>
                    </Border>

                    <TextBlock Text="Нікнейм" Foreground="#4A3532" FontSize="13" FontWeight="SemiBold" Margin="4,0,0,4"/>
                    <Border Background="#E3D1BD" CornerRadius="14" Height="38" Padding="12,0" Margin="0,0,0,10">
                        <TextBox x:Name="ProfileUsernameTextBox"/>
                    </Border>

                    <TextBlock Text="Електронна пошта" Foreground="#4A3532" FontSize="13" FontWeight="SemiBold" Margin="4,0,0,4"/>
                    <Border Background="#E3D1BD" CornerRadius="14" Height="38" Padding="12,0" Margin="0,0,0,14">
                        <TextBox x:Name="ProfileEmailTextBox"/>
                    </Border>

                    <Button x:Name="UpdateProfileButton"
                            Click="UpdateProfileButton_Click"
                            Content="Зберегти особисті дані"
                            Height="38"
                            Background="#4A3532"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            BorderBrush="Transparent"
                            Cursor="Hand"
                            Margin="0,0,0,18">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="14"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Separator Background="#8C7365" Margin="0,0,0,16"/>

                    <!-- Розділ зміни пароля -->
                    <TextBlock Text="Новий пароль" Foreground="#4A3532" FontSize="13" FontWeight="SemiBold" Margin="4,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#E3D1BD" CornerRadius="14" Height="38" Padding="12,0" Margin="0,0,8,0">
                            <PasswordBox x:Name="NewPasswordBox"/>
                        </Border>

                        <Button Grid.Column="1"
                                x:Name="ChangePasswordButton"
                                Click="ChangePasswordButton_Click"
                                Content="Змінити пароль"
                                Height="38"
                                Background="#4A3532"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="13"
                                BorderBrush="Transparent"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="14"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
