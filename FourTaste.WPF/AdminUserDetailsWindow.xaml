<Window x:Class="FourTaste.WPF.AdminUserDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="4taste - Профіль користувача" Height="560" Width="780"
        WindowStartupLocation="CenterScreen" Background="#E3D1BD"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#D8B5A8"/>
            <Setter Property="Foreground" Value="#D9534F"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30,25,30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Grid Width="90" Height="90" Margin="0,0,16,0">
                        <Border x:Name="DefaultAvatarBorder" CornerRadius="45" Background="#EBB832">
                            <TextBlock x:Name="InitialTextBlock" FontSize="36" FontWeight="Bold"
                                       Foreground="#4A3532" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="CustomAvatarBorder" CornerRadius="45" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="AvatarImageBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NameTextBlock" FontSize="24" FontWeight="Bold" Foreground="#4A3532"/>
                        <TextBlock x:Name="NicknameTextBlock" FontSize="15" Foreground="#7A6865"/>
                        <TextBlock x:Name="EmailTextBlock" FontSize="14" Foreground="#7A6865"/>
                        <Border x:Name="AdminBadge" Visibility="Collapsed" Background="#EBB832" CornerRadius="10"
                                Padding="10,2" Margin="0,6,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="Адмін" FontWeight="Bold" FontSize="12" Foreground="#4A3532"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Border Background="#C4B4A4" CornerRadius="22" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="RegisteredTextBlock" FontSize="15" Foreground="#4A3532" Margin="0,0,0,8"/>
                        <TextBlock x:Name="StatusTextBlock" FontSize="15" FontWeight="SemiBold" Foreground="#4A3532"/>
                        <TextBlock x:Name="ReasonTextBlock" FontSize="14" Foreground="#4A3532"
                                   TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <Button x:Name="WarningButton" Content="Попередження" Style="{StaticResource PillButton}"
                        Click="WarningButton_Click"/>
                <Button x:Name="BlockButton" Content="Заблокувати" Style="{StaticResource PillButton}"
                        Click="BlockButton_Click"/>
                <Button x:Name="DeleteButton" Content="Видалити профіль" Style="{StaticResource PillButton}"
                        Click="DeleteButton_Click"/>
                <TextBlock x:Name="HintTextBlock" Visibility="Collapsed" Foreground="#7A6865" FontSize="12"
                           TextWrapping="Wrap" Text="Модерувати можна лише акаунти звичайних користувачів."/>
            </StackPanel>
        </Grid>

        <Button Grid.Row="1" x:Name="BackButton" Content="Назад" Style="{StaticResource PillButton}"
                Background="#C4B4A4" Foreground="#4A3532" Width="140" HorizontalAlignment="Left"
                Margin="0,15,0,0" Click="BackButton_Click"/>
    </Grid>
</Window>