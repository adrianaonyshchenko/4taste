<Window x:Class="FourTaste.WPF.FridgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мої продукти" Height="680" Width="850" WindowStartupLocation="CenterScreen" Background="#E3D1BD">
    <Grid Margin="30,25,30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Мої продукти" FontSize="24" FontWeight="Bold" Foreground="#4A3532" Margin="0,0,0,20"/>

        <!-- Основний вміст (дві колонки: У мене є / Купити) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Колонка 1: У мене є (Холодильник - UC 27) -->
            <Border Grid.Column="0" Background="#C4B4A4" CornerRadius="22" Margin="0,0,15,0" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="У мене є" HorizontalAlignment="Center" Foreground="#4A3532" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>

                    <!-- Список продуктів (У мене є) -->
                    <ListBox x:Name="FridgeItemsListBox" Grid.Row="1" Background="Transparent" BorderBrush="Transparent" Foreground="#4A3532" FontSize="14" Margin="0,0,0,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5,3">
                                    <TextBlock Text="{Binding IngredientName}" Width="150" VerticalAlignment="Center" Foreground="#4A3532" FontWeight="SemiBold"/>
                                    <Border Background="#4A3532" CornerRadius="10" Padding="6,2" MinWidth="55" Margin="10,0,0,0" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Quantity}" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,2,0"/>
                                            <TextBlock Text="{Binding Unit}" Foreground="White" FontWeight="Normal" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Поля введення (У мене є): Назва, Кількість, Одиниця -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#E3D1BD" CornerRadius="12" Height="36" Padding="8,0" Margin="0,0,6,0">
                            <TextBox x:Name="NewIngredientTextBox" KeyDown="FridgeInput_KeyDown" Background="Transparent" BorderBrush="Transparent" VerticalContentAlignment="Center" FontSize="13" Foreground="#4A3532" ToolTip="Продукт"/>
                        </Border>

                        <Border Grid.Column="1" Background="#E3D1BD" CornerRadius="12" Height="36" Padding="2,0" Margin="0,0,6,0">
                            <TextBox x:Name="NewQuantityTextBox" KeyDown="FridgeInput_KeyDown" Text="1" Background="Transparent" BorderBrush="Transparent" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#4A3532" ToolTip="Кількість"/>
                        </Border>

                        <Border Grid.Column="2" Background="#E3D1BD" CornerRadius="12" Height="36" Padding="2,0">
                            <TextBox x:Name="NewUnitTextBox" KeyDown="FridgeInput_KeyDown" Text="шт" Background="Transparent" BorderBrush="Transparent" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="12" Foreground="#4A3532" ToolTip="Одиниця (г, кг, мл, л, шт)"/>
                        </Border>
                    </Grid>

                    <!-- Кнопки керування -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Додати" Click="AddFridgeItemButton_Click" Width="120" Height="34" Background="#4A3532" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="14"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Видалити" Click="DeleteFridgeItemButton_Click" Width="120" Height="34" Background="#D8B5A8" Foreground="#D9534F" FontWeight="Bold" BorderBrush="Transparent">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="14"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Колонка 2: Купити -->
            <Border Grid.Column="1" Background="#C4B4A4" CornerRadius="22" Margin="15,0,0,0" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Купити" HorizontalAlignment="Center" Foreground="#4A3532" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>

                    <!-- Список продуктів (Купити) -->
                    <ListBox x:Name="ShoppingList" Grid.Row="1" Background="Transparent" BorderBrush="Transparent" Foreground="#4A3532" FontSize="14" Margin="0,0,0,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5,3">
                                    <TextBlock Text="{Binding IngredientName}" Width="150" VerticalAlignment="Center" Foreground="#4A3532" FontWeight="SemiBold"/>
                                    <Border Background="#4A3532" CornerRadius="10" Padding="6,2" MinWidth="55" Margin="10,0,0,0" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Quantity}" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,2,0"/>
                                            <TextBlock Text="{Binding Unit}" Foreground="White" FontWeight="Normal" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Поля введення (Купити): Назва, Кількість, Одиниця -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#E3D1BD" CornerRadius="12" Height="36" Padding="8,0" Margin="0,0,6,0">
                            <TextBox x:Name="NewShoppingItemTextBox" KeyDown="ShoppingInput_KeyDown" Background="Transparent" BorderBrush="Transparent" VerticalContentAlignment="Center" FontSize="13" Foreground="#4A3532" ToolTip="Продукт для купівлі"/>
                        </Border>

                        <Border Grid.Column="1" Background="#E3D1BD" CornerRadius="12" Height="36" Padding="2,0" Margin="0,0,6,0">
                            <TextBox x:Name="NewShoppingQuantityTextBox" KeyDown="ShoppingInput_KeyDown" Text="1" Background="Transparent" BorderBrush="Transparent" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#4A3532" ToolTip="Кількість"/>
                        </Border>

                        <Border Grid.Column="2" Background="#E3D1BD" CornerRadius="12" Height="36" Padding="2,0">
                            <TextBox x:Name="NewShoppingUnitTextBox" KeyDown="ShoppingInput_KeyDown" Text="шт" Background="Transparent" BorderBrush="Transparent" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="12" Foreground="#4A3532" ToolTip="Одиниця (г, кг, мл, л, шт)"/>
                        </Border>
                    </Grid>

                    <!-- Кнопки керування -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Додати" Click="AddShoppingItemButton_Click" Width="120" Height="34" Background="#4A3532" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="14"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Видалити" Click="DeleteShoppingItemButton_Click" Width="120" Height="34" Background="#D8B5A8" Foreground="#D9534F" FontWeight="Bold" BorderBrush="Transparent">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="14"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Нижня панель -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Назад" Click="BackButton_Click" HorizontalAlignment="Left" Width="120" Height="40" Background="#C4B4A4" Foreground="#4A3532" FontWeight="Bold" BorderBrush="Transparent">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Знайти рецепт для мене" Click="FindRecipeForMeButton_Click" HorizontalAlignment="Right" Width="240" Height="40" Background="#4A3532" Foreground="White" FontWeight="Bold" BorderBrush="Transparent">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>