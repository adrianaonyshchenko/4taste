<Window x:Class="FourTaste.WPF.CookingHistoryWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="4taste" Height="730" Width="1100"
WindowStartupLocation="CenterScreen"
Background="#E5D3BD"
Loaded="Window_Loaded">

    <Grid Margin="30,16,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Верхній рядок: Логотип, Пошуковий рядок, Кружечок "Мій профіль" -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Логотип та бренд -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="logo.png" Height="48" Width="48" Margin="0,0,8,0" Stretch="Uniform"/>
                <TextBlock Text="4taste"
Foreground="#4A3532"
FontSize="22"
FontWeight="Bold"
VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Пошуковий рядок (шаблон як на макеті) -->
            <Border Grid.Column="1"
Background="#F4EAE0"
BorderBrush="#C4B4A4"
BorderThickness="1"
CornerRadius="20"
Height="42"
MaxWidth="520"
Margin="30,0"
Padding="18,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
Text="Пошук..."
Foreground="#8A7975"
FontSize="14"
VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
Text="🔍"
FontSize="16"
Foreground="#4A3532"
VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Кружечок Мій профіль -->
            <Button Grid.Column="2"
x:Name="ProfileButton"
Click="ProfileButton_Click"
Background="Transparent"
BorderBrush="Transparent"
Padding="0"
Cursor="Hand"
ToolTip="Мій профіль">
                <Grid Width="64" Height="64">
                    <Border x:Name="DefaultAvatarBorder"
Width="64" Height="64"
CornerRadius="32"
Background="#EBB832">
                        <TextBlock Text="Мій&#10;профіль"
TextAlignment="Center"
VerticalAlignment="Center"
FontWeight="Bold"
FontSize="11"
Foreground="#4A3532"/>
                    </Border>
                    <Border x:Name="CustomAvatarBorder"
Width="64" Height="64"
CornerRadius="32"
Visibility="Collapsed">
                        <Border.Background>
                            <ImageBrush x:Name="UserAvatarImageBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>
            </Button>
        </Grid>

        <!-- 2. Рядок кнопок дій та кімнат (шаблони з макета) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <!-- Кнопка "+ Додати рецепт" -->
            <Border x:Name="AddRecipeButton"
Width="110" Height="64"
Background="#EBB832"
CornerRadius="18"
Margin="0,0,12,0"
Cursor="Hand"
MouseLeftButtonUp="AddRecipeButton_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="+" FontSize="22" FontWeight="Bold" Foreground="#4A3532" HorizontalAlignment="Center" Margin="0,-4,0,-2"/>
                    <TextBlock Text="Додати&#10;рецепт" TextAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#4A3532" LineHeight="13"/>
                </StackPanel>
            </Border>

            <!-- Кнопка "+ Створити кімнату" -->
            <Border Width="120" Height="64"
Background="#BCA99B"
CornerRadius="18"
Margin="0,0,12,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="+" FontSize="22" FontWeight="Bold" Foreground="#4A352F" HorizontalAlignment="Center" Margin="0,-4,0,-2"/>
                    <TextBlock Text="Створити&#10;кімнату" TextAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#4A352F" LineHeight="13"/>
                </StackPanel>
            </Border>

            <!-- Кнопка "Назва кімнати 1" -->
            <Border Width="120" Height="64"
Background="#877063"
CornerRadius="18"
Margin="0,0,12,0">
                <TextBlock Text="Назва&#10;кімнати 1" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="White" LineHeight="15"/>
            </Border>

            <!-- Кнопка "Назва кімнати 2" -->
            <Border Width="120" Height="64"
Background="#877063"
CornerRadius="18">
                <TextBlock Text="Назва&#10;кімнати 2" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="White" LineHeight="15"/>
            </Border>
        </StackPanel>

        <!-- 3. Підзаголовок: "Історія рецептів" та кнопка "Популярні рецепти" -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Історія рецептів"
                       Foreground="#4A3532"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>

            <Button HorizontalAlignment="Right"
                    x:Name="PublicRecipesButton"
                    Click="PublicRecipesButton_Click"
                    Background="#4A3532"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="16,8">
                            <TextBlock Text="Популярні рецепти"
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 4. Основний контент: сітка карток історії рецептів -->
        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ListBox x:Name="CookingHistoryListBox"
Background="Transparent"
BorderBrush="Transparent"
BorderThickness="0"
ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="310"
Background="#877063"
CornerRadius="18"
Padding="15"
Margin="8,6">
                                <StackPanel>
                                    <!-- Фото рецепту (шаблон) -->
                                    <Border Height="120"
Background="#DDD4C8"
CornerRadius="14"
Margin="0,0,0,10">
                                        <TextBlock Text="фото"
Foreground="#6B5B54"
FontSize="15"
FontWeight="Medium"
HorizontalAlignment="Center"
VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Назва рецепту (поле назви) -->
                                    <TextBlock Text="{Binding RecipeName}"
Foreground="White"
FontWeight="Bold"
FontSize="15"
TextWrapping="Wrap"
Margin="2,0,0,8"/>

                                    <!-- ДНК рецепту (шаблонні пігулки) -->
                                    <WrapPanel Margin="0,0,0,2">
                                        <Border Background="#DDD4C8" CornerRadius="10" Padding="10,4" Margin="0,0,6,6">
                                            <TextBlock Text="ДНК рецепту" Foreground="#4A3532" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                        <Border Background="#DDD4C8" CornerRadius="10" Padding="10,4" Margin="0,0,6,6">
                                            <TextBlock Text="ДНК рецепту" Foreground="#4A3532" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                        <Border Background="#DDD4C8" CornerRadius="10" Padding="10,4" Margin="0,0,6,6">
                                            <TextBlock Text="ДНК рецепту" Foreground="#4A3532" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                        <Border Background="#DDD4C8" CornerRadius="10" Padding="10,4" Margin="0,0,6,6">
                                            <TextBlock Text="ДНК рецепту" Foreground="#4A3532" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <TextBlock x:Name="EmptyHistoryTextBlock"
Text="Ви ще не позначили жодної страви як приготовлену.&#10;Щоб додати страву до історії, відмітьте її у меню на календарі."
TextAlignment="Center"
Foreground="#7A6865"
FontSize="16"
FontWeight="SemiBold"
HorizontalAlignment="Center"
VerticalAlignment="Center"
LineHeight="26"
Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>