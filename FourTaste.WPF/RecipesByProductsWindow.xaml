<Window x:Class="FourTaste.WPF.RecipesByProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рецепти з моїх продуктів" Height="680" Width="850" WindowStartupLocation="CenterOwner" Background="#E3D1BD"
        Loaded="Window_Loaded">
    <Grid Margin="30,25,30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Рецепти з моїх продуктів" FontSize="24" FontWeight="Bold" Foreground="#4A3532" Margin="0,0,0,15"/>

        <!-- Фільтри -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Категорія" Foreground="#4A3532" FontSize="12" Margin="0,0,0,3"/>
                <ComboBox x:Name="CategoryComboBox" Width="190" Height="32" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Кухня" Foreground="#4A3532" FontSize="12" Margin="0,0,0,3"/>
                <ComboBox x:Name="CuisineComboBox" Width="160" Height="32" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Макс. час, хв" Foreground="#4A3532" FontSize="12" Margin="0,0,0,3"/>
                <TextBox x:Name="MaxMinutesTextBox" Width="100" Height="32" VerticalContentAlignment="Center" ToolTip="Залиште порожнім, щоб не обмежувати"/>
            </StackPanel>
            <Button x:Name="SearchButton" Content="Шукати" Click="SearchButton_Click" Width="120" Height="34" VerticalAlignment="Bottom" Background="#4A3532" Foreground="White" FontWeight="Bold" BorderBrush="Transparent">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="2" TextWrapping="Wrap" Foreground="#6B5148" FontSize="12" Margin="0,0,0,10"
                   Text="Рецепти з вашими алергенами виключаються за назвою інгредієнта. Завжди перевіряйте склад самостійно."/>

        <!-- Результати -->
        <Grid Grid.Row="3">
            <ListBox x:Name="RecipesListBox" Background="Transparent" BorderBrush="Transparent" SelectionChanged="RecipesListBox_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#C4B4A4" CornerRadius="16" Padding="14,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#4A3532"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Збігається: " Foreground="#4A3532" FontSize="13"/>
                                    <TextBlock Text="{Binding MatchedIngredientsCount}" Foreground="#4A3532" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text=" з " Foreground="#4A3532" FontSize="13"/>
                                    <TextBlock Text="{Binding TotalIngredientsCount}" Foreground="#4A3532" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text=" інгредієнтів" Foreground="#4A3532" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Category}" Foreground="#6B5148" FontSize="12"/>
                                    <TextBlock Text="  •  " Foreground="#6B5148" FontSize="12"/>
                                    <TextBlock Text="{Binding Cuisine}" Foreground="#6B5148" FontSize="12"/>
                                    <TextBlock Text="  •  " Foreground="#6B5148" FontSize="12"/>
                                    <TextBlock Text="{Binding Time}" Foreground="#6B5148" FontSize="12"/>
                                    <TextBlock Text="  •  " Foreground="#6B5148" FontSize="12"/>
                                    <TextBlock Text="{Binding AuthorDisplayName}" Foreground="#6B5148" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyTextBlock" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#4A3532" FontSize="16"/>
        </Grid>

        <Button Grid.Row="4" Content="Назад" Click="BackButton_Click" HorizontalAlignment="Left" Width="120" Height="40" Margin="0,15,0,0" Background="#C4B4A4" Foreground="#4A3532" FontWeight="Bold" BorderBrush="Transparent">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="14"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
