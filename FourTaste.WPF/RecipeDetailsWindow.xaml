<Window x:Class="FourTaste.WPF.RecipeDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Перегляд рецепта" Height="780" Width="1080" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#EADCC9"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="#D5C4B4"/>
            <Setter Property="Foreground" Value="#4A352F"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="18" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline" FontSize="{TemplateBinding FontSize}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#B89F8B" CornerRadius="18" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#E3D7CB" CornerRadius="12" Height="190"
                            ClipToBounds="True" Margin="0,0,0,15">
                        <Grid>
                            <TextBlock x:Name="PhotoPlaceholder" Text="фото" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="#7A685D" FontSize="14"/>
                            <Image x:Name="RecipeImage" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#E3D7CB" CornerRadius="12" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Інгредієнти" FontWeight="Bold" FontSize="14"
                                       Foreground="#4A352F" Margin="0,0,0,8"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="IngredientsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,3" Background="#F1E8DF" CornerRadius="8" Padding="8,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="⚠ " Foreground="#D93829" FontWeight="Bold" FontSize="13"
                                                                       Visibility="{Binding AllergenWarningVisibility}"
                                                                       ToolTip="Алерген для вашого профілю"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="{Binding TextColor}"
                                                                       FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding SubstitutedBadgeVisibility}" Margin="0,3,0,0">
                                                            <Border Background="#2E7D32" CornerRadius="6" Padding="6,1" Margin="0,0,6,0">
                                                                <TextBlock Text="замінено" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                            <Button Content="↩ повернути" Style="{StaticResource TextLinkButton}"
                                                                    Click="RevertSubstitutionButton_Click" Tag="{Binding}"
                                                                    Foreground="#7A685D" FontSize="11" ToolTip="Скасувати заміну та повернути оригінал"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="#542E2B" CornerRadius="10"
                                                            Padding="8,2" VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding Amount}" Foreground="White"
                                                                   FontSize="12" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Button Grid.Row="2" x:Name="FindSubstituteButton" Content="Знайти замінник алергену"
                                    Style="{StaticResource PillButton}" Background="#542E2B" Foreground="White"
                                    Height="44" Margin="0,12,0,0" IsEnabled="False"
                                    Click="FindSubstituteButton_Click"
                                    ToolTip="Пошук безпечних замінників для алергенів у цьому рецепті"/>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="1" x:Name="SubstitutePanel" Width="330" Background="#E3D7CB" CornerRadius="14"
                        Padding="15" Margin="0,0,20,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Замінити" FontSize="20" FontWeight="Bold" Foreground="#4A352F" VerticalAlignment="Center"/>
                            <Button x:Name="CloseSubstitutePanelButton" Content="✕" Width="28" Height="28"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Background="#D5C4B4"
                                    Foreground="#4A352F" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                                    Click="CloseSubstitutePanelButton_Click" ToolTip="Закрити панель">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="14"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1" Background="#F1E8DF" CornerRadius="10" Padding="10,8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Алерген в рецепті:" FontSize="11" Foreground="#7A685D" Margin="0,0,0,2"/>
                                <ComboBox x:Name="AllergenicIngredientsComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectionChanged="AllergenicIngredientsComboBox_SelectionChanged"
                                          FontSize="14" FontWeight="Bold" Foreground="#D93829" Margin="0,0,0,4"
                                          Background="White"/>
                                <TextBlock x:Name="SelectedAllergenNameTextBlock" Text="Алерген" FontSize="15" FontWeight="Bold"
                                           Foreground="#D93829" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <StackPanel x:Name="SubstituteLoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <ProgressBar IsIndeterminate="True" Width="140" Height="6" Margin="0,0,0,10"/>
                                <TextBlock Text="Шукаємо безпечні замінники..." Foreground="#7A685D" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Border x:Name="SubstituteErrorPanel" Background="#FFEBEE" CornerRadius="8" Padding="12" VerticalAlignment="Center" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="⚠ Помилка завантаження" FontWeight="Bold" Foreground="#D93829" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="SubstituteErrorTextBlock" Text="Не вдалося отримати замінники." Foreground="#7A685D" FontSize="12" TextWrapping="Wrap"/>
                                    <Button Content="Спробувати знову" Style="{StaticResource PillButton}" Background="#B89F8B" Height="32" Margin="0,8,0,0"
                                            Click="RetrySubstituteButton_Click"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="SubstituteEmptyPanel" Background="#F1E8DF" CornerRadius="8" Padding="14" VerticalAlignment="Center" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="ℹ️" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Безпечних замінників для цього інгредієнта не знайдено."
                                               Foreground="#7A685D" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <ScrollViewer x:Name="SubstituteListScrollViewer" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="SubstituteOptionsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F9F6F0" CornerRadius="10" Padding="10" Margin="0,0,0,8"
                                                    BorderBrush="#D5C4B4" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton Grid.Column="0" GroupName="SubstitutesGroup"
                                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                 Checked="SubstituteRadioButton_Checked"
                                                                 VerticalAlignment="Top" Margin="0,2,8,0"
                                                                 AutomationProperties.Name="{Binding Name}"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                                                   Foreground="#4A352F" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding DisplayDetails}" FontSize="12"
                                                                   Foreground="#2E7D32" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Note}" FontSize="11" Foreground="#7A685D"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   Visibility="{Binding NoteVisibility}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Border Grid.Row="3" Background="#FFF8E1" CornerRadius="6" Padding="8,5" Margin="0,0,0,10">
                            <TextBlock Text="⚠ Перевіряйте склад продуктів на упаковці" FontSize="11"
                                       Foreground="#7A685D" TextAlignment="Center" TextWrapping="Wrap"/>
                        </Border>

                        <Grid Grid.Row="4">
                            <Button x:Name="SaveSubstitutionButton" Content="Зберегти"
                                    Style="{StaticResource PillButton}" Background="#542E2B" Foreground="White"
                                    Height="40" IsEnabled="False" Click="SaveSubstitutionButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="TitleTextBlock" FontSize="26" FontWeight="Bold"
                                   Foreground="#4A352F" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Margin="0,0,160,0"/>
                        <Border Background="#E3D7CB" CornerRadius="12" Padding="12,4"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock x:Name="AuthorTextBlock" Foreground="#4A352F" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TimeTextBlock" Foreground="#4A352F" FontSize="14" Margin="0,2"/>
                            <TextBlock x:Name="CategoryTextBlock" Foreground="#4A352F" FontSize="14" Margin="0,2"/>
                            <TextBlock x:Name="CuisineTextBlock" Foreground="#4A352F" FontSize="14" Margin="0,2"/>
                            <TextBlock x:Name="StatusTextBlock" Foreground="#4A352F" FontSize="14" Margin="0,2"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Width="130" VerticalAlignment="Center">
                            <Border Background="#E3D7CB" CornerRadius="12" Padding="10">
                                <TextBlock x:Name="ServingsTextBlock" Text="1&#10;порція" TextAlignment="Center" FontSize="20"
                                           Foreground="#4A352F" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Background="#947A66" CornerRadius="12" Padding="15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Порядок приготування" FontWeight="Bold" FontSize="14"
                                           Foreground="White" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="StepsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding StepNumber, StringFormat={}{0}.}"
                                                           FontWeight="Bold" Foreground="White" FontSize="14"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                           Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="AddToListButton" Content="Додати до списку"
                                Style="{StaticResource PillButton}" Height="44" Margin="0,0,12,0"
                                IsEnabled="False" ToolTip="Буде доступно пізніше"/>
                        <Button Grid.Column="1" x:Name="EditRecipeButton" Content="Змінити"
                                Style="{StaticResource PillButton}" Height="44"
                                Click="EditRecipeButton_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BackButton" Content="Назад" Click="BackButton_Click"
                    Style="{StaticResource PillButton}" Background="#B89F8B" Height="44" Margin="0,0,10,0"/>
            <Button Grid.Column="1" x:Name="ShareButton" Content="Поділитися"
                    Style="{StaticResource PillButton}" Background="#B89F8B" Height="44" Margin="0,0,10,0"
                    IsEnabled="False" ToolTip="Буде доступно пізніше"/>
            <Button Grid.Column="2" x:Name="ReviewsButton" Content="Відгуки"
                    Style="{StaticResource PillButton}" Background="#B89F8B" Height="44" Margin="0,0,10,0"
                    IsEnabled="False" ToolTip="Буде доступно пізніше"/>
            <Button Grid.Column="3" x:Name="CookButton" Content="Готувати"
                    Style="{StaticResource PillButton}" Background="#542E2B" Foreground="White" Height="44"
                    IsEnabled="False" ToolTip="Буде доступно пізніше"/>
        </Grid>
    </Grid>
</Window>
