<Window x:Class="FourTaste.WPF.PublicRecipesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FourTaste.WPF"
        Title="4taste - Популярні рецепти" Height="730" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#E5D3BD"
        Loaded="Window_Loaded">

    <Window.Resources>
        <local:BytesToImageConverter x:Key="BytesToImageConverter"/>

        <Style x:Key="FilterRadioPillStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7A6865"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#4A3532"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#4A3532"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30,16,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="logo.png" Height="48" Width="48" Margin="0,0,8,0" Stretch="Uniform"/>
                <TextBlock Text="4taste"
                           Foreground="#4A3532"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#F4EAE0"
                    BorderBrush="#C4B4A4"
                    BorderThickness="1"
                    CornerRadius="20"
                    Height="42"
                    MaxWidth="560"
                    Margin="30,0"
                    Padding="16,0,12,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Текст-підказка (Placeholder) -->
                    <TextBlock x:Name="SearchPlaceholderTextBlock"
                               Grid.Column="0"
                               Text="Пошук рецептів за назвою або автором..."
                               Foreground="#8A7975"
                               FontSize="14"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Margin="2,0,0,0"/>

                    <!-- Поле вводу пошуку -->
                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="0"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#4A3532"
                             FontSize="14"
                             VerticalAlignment="Center"
                             CaretBrush="#4A3532"
                             Padding="0"
                             TextChanged="SearchTextBox_TextChanged"
                             KeyDown="SearchTextBox_KeyDown"/>

                    <!-- Кнопка очищення (хрестик) -->
                    <Button x:Name="ClearSearchButton"
                            Grid.Column="1"
                            Click="ClearSearchButton_Click"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="#8A7975"
                            FontSize="14"
                            FontWeight="Bold"
                            Padding="6,0"
                            Margin="0,0,4,0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            ToolTip="Очистити пошук">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="✕"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Іконка / кнопка пошуку -->
                    <Button x:Name="SearchButton"
                            Grid.Column="2"
                            Click="SearchButton_Click"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="4,0"
                            Cursor="Hand"
                            ToolTip="Шукати">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="🔍"
                                           FontSize="16"
                                           Foreground="#4A3532"
                                           VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Button Grid.Column="2"
                    x:Name="ProfileButton"
                    Click="ProfileButton_Click"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="0"
                    Cursor="Hand"
                    ToolTip="Мій профіль">
                <Grid Width="64" Height="64">
                    <Border x:Name="DefaultAvatarBorder"
                            Width="64" Height="64"
                            CornerRadius="32"
                            Background="#EBB832">
                        <TextBlock Text="Мій&#10;профіль"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   Foreground="#4A3532"/>
                    </Border>
                    <Border x:Name="CustomAvatarBorder"
                            Width="64" Height="64"
                            CornerRadius="32"
                            Visibility="Collapsed">
                        <Border.Background>
                            <ImageBrush x:Name="UserAvatarImageBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Border x:Name="AddRecipeButton"
                    Width="110" Height="64"
                    Background="#EBB832"
                    CornerRadius="18"
                    Margin="0,0,12,0"
                    Cursor="Hand"
                    MouseLeftButtonUp="AddRecipeButton_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="+" FontSize="22" FontWeight="Bold" Foreground="#4A3532" HorizontalAlignment="Center" Margin="0,-4,0,-2"/>
                    <TextBlock Text="Додати&#10;рецепт" TextAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#4A3532" LineHeight="13"/>
                </StackPanel>
            </Border>

            <Border Width="120" Height="64"
                    Background="#BCA99B"
                    CornerRadius="18"
                    Margin="0,0,12,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="+" FontSize="22" FontWeight="Bold" Foreground="#4A352F" HorizontalAlignment="Center" Margin="0,-4,0,-2"/>
                    <TextBlock Text="Створити&#10;кімнату" TextAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#4A352F" LineHeight="13"/>
                </StackPanel>
            </Border>

            <Border Width="120" Height="64"
                    Background="#877063"
                    CornerRadius="18"
                    Margin="0,0,12,0">
                <TextBlock Text="Назва&#10;кімнати 1" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="White" LineHeight="15"/>
            </Border>

            <Border Width="120" Height="64"
                    Background="#877063"
                    CornerRadius="18">
                <TextBlock Text="Назва&#10;кімнати 2" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="White" LineHeight="15"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Публічні рецепти"
                           Foreground="#4A3532"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <!-- Фільтр критерію пошуку (пігулки/чіпи) -->
                <Border Background="#F4EAE0" CornerRadius="14" Padding="3" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FilterAllRadio"
                                     GroupName="SearchFilterGroup"
                                     Content="Всі"
                                     IsChecked="True"
                                     Checked="FilterRadio_Checked"
                                     Style="{StaticResource FilterRadioPillStyle}"/>
                        <RadioButton x:Name="FilterTitleRadio"
                                     GroupName="SearchFilterGroup"
                                     Content="За назвою"
                                     Checked="FilterRadio_Checked"
                                     Style="{StaticResource FilterRadioPillStyle}"/>
                        <RadioButton x:Name="FilterAuthorRadio"
                                     GroupName="SearchFilterGroup"
                                     Content="За автором"
                                     Checked="FilterRadio_Checked"
                                     Style="{StaticResource FilterRadioPillStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Лічильник знайдених результатів -->
                <TextBlock x:Name="ResultsCountTextBlock"
                           Foreground="#7A6865"
                           FontSize="13"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </StackPanel>

            <Button HorizontalAlignment="Right"
                    x:Name="CookingHistoryButton"
                    Click="CookingHistoryButton_Click"
                    Background="#4A3532"
                    BorderBrush="Transparent"
                    Padding="16,8"
                    Cursor="Hand"
                    VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="16,8">
                            <TextBlock Text="Історія рецептів"
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ListBox x:Name="RecipesListBox"
         SelectionChanged="RecipesListBox_SelectionChanged"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="310"
                                    Background="#877063"
                                    CornerRadius="18"
                                    Padding="15"
                                    Margin="8,6">
                                <StackPanel>
                                    <Border Height="120"
                                            Background="#DDD4C8"
                                            CornerRadius="14"
                                            Margin="0,0,0,10"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Border CornerRadius="14" ClipToBounds="True">
                                                <Image Source="{Binding Photo, Converter={StaticResource BytesToImageConverter}}"
                                                       Stretch="UniformToFill"/>
                                            </Border>

                                            <TextBlock Text="Фото рецепту"
                                                       Foreground="#6B5B54"
                                                       FontSize="15"
                                                       FontWeight="Medium"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Photo}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding Title}"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               TextWrapping="Wrap"
                                               Margin="2,0,0,4"/>

                                    <!-- Автор рецепта -->
                                    <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                        <TextBlock Text="👤 " FontSize="11" Foreground="#DDD4C8" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AuthorDisplayName}"
                                                   Foreground="#F4EAE0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <WrapPanel Margin="0,0,0,2">
                                        <Border Background="#DDD4C8" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding Category}" Foreground="#4A3532" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                        <Border Background="#DDD4C8" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding Cuisine}" Foreground="#4A3532" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                        <Border Background="#DDD4C8" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding Time}" Foreground="#4A3532" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <TextBlock x:Name="EmptyTextBlock"
                       Text="Поки немає жодного публічного рецепта.&#10;Будьте першим, хто поділиться рецептом!"
                       TextAlignment="Center"
                       Foreground="#7A6865"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       LineHeight="26"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
