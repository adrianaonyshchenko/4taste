<Window x:Class="FourTaste.WPF.MyRecipesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="4taste - Мої рецепти" Height="730" Width="1100"
        xmlns:local="clr-namespace:FourTaste.WPF"
        WindowStartupLocation="CenterScreen"
        Background="#E5D3BD"
        Loaded="Window_Loaded">

    <Window.Resources>
        <local:BytesToImageConverter x:Key="BytesToImageConverter"/>
    </Window.Resources>

    <Grid Margin="30,16,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Верхній рядок: Логотип, Заголовок та кнопка "Вийти" -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Логотип та бренд -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="logo.png" Height="48" Width="48" Margin="0,0,8,0" Stretch="Uniform"/>
                <TextBlock Text="4taste"
                           Foreground="#4A3532"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Заголовок вікна -->
            <TextBlock Grid.Column="1"
                       Text="Мої рецепти"
                       Foreground="#4A3532"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- Кнопка "Вийти" (повернення на головну) -->
            <Button Grid.Column="2"
                    x:Name="ExitButton"
                    Click="ExitButton_Click"
                    Background="#4A3532"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="16,8">
                            <TextBlock Text="Вийти"
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 2. Основний контент: список власних рецептів -->
        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ListBox x:Name="RecipesListBox"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="310"
                                    Background="#877063"
                                    CornerRadius="18"
                                    Padding="15"
                                    Margin="8,6">
                                <StackPanel>
                                    <!-- Блок для фото з закругленими кутами -->
                                    <Border Height="120"
        Background="#DDD4C8"
        CornerRadius="14"
        Margin="0,0,0,10"
        ClipToBounds="True">
                                        <Grid>
                                            <!-- Фотографія рецепта -->
                                            <Border CornerRadius="14" ClipToBounds="True">
                                                <Image Source="{Binding Photo, Converter={StaticResource BytesToImageConverter}}"
Stretch="UniformToFill"/>
                                            </Border>

                                            <!-- Текст-заглушка, якщо фото відсутнє -->
                                            <TextBlock Text="Фото рецепту"
                   Foreground="#6B5B54"
                   FontSize="15"
                   FontWeight="Medium"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Photo}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- Назва рецепту -->
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               TextWrapping="Wrap"
                                               Margin="2,0,0,10"/>

                                    <!-- ДНК рецепту: Категорія, Кухня, Час -->
                                    <WrapPanel Margin="0,0,0,2">
                                        <Border Background="#DDD4C8" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding Category}" Foreground="#4A3532" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                        <Border Background="#DDD4C8" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding Cuisine}" Foreground="#4A3532" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                        <Border Background="#DDD4C8" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding Time}" Foreground="#4A3532" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <TextBlock x:Name="EmptyTextBlock"
                       Text="У вас поки немає створених рецептів.&#10;Додайте свій перший рецепт!"
                       TextAlignment="Center"
                       Foreground="#7A6865"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       LineHeight="26"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>