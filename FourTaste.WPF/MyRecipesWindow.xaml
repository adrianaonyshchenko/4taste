<Window x:Class="FourTaste.WPF.MyRecipesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="4taste - Мої рецепти" Height="730" Width="1100"
        xmlns:local="clr-namespace:FourTaste.WPF"
        WindowStartupLocation="CenterScreen"
        Background="#E5D3BD"
        Loaded="Window_Loaded">

    <Window.Resources>
        <local:BytesToImageConverter x:Key="BytesToImageConverter"/>
    </Window.Resources>

    <Grid Margin="30,16,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="logo.png" Height="48" Width="48" Margin="0,0,8,0" Stretch="Uniform"/>
                <TextBlock Text="4taste"
                           Foreground="#4A3532"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Пошуковий рядок -->
            <Border Grid.Column="1"
                    Background="#F4EAE0"
                    BorderBrush="#C4B4A4"
                    BorderThickness="1"
                    CornerRadius="20"
                    Height="42"
                    MaxWidth="560"
                    Margin="30,0"
                    Padding="16,0,12,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Текст-підказка (Placeholder) -->
                    <TextBlock x:Name="SearchPlaceholderTextBlock"
                               Grid.Column="0"
                               Text="Пошук серед моїх рецептів..."
                               Foreground="#8A7975"
                               FontSize="14"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Margin="2,0,0,0"/>

                    <!-- Поле вводу пошуку -->
                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="0"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#4A3532"
                             FontSize="14"
                             VerticalAlignment="Center"
                             CaretBrush="#4A3532"
                             Padding="0"
                             TextChanged="SearchTextBox_TextChanged"
                             KeyDown="SearchTextBox_KeyDown"/>

                    <!-- Кнопка очищення (хрестик) -->
                    <Button x:Name="ClearSearchButton"
                            Grid.Column="1"
                            Click="ClearSearchButton_Click"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="#8A7975"
                            FontSize="14"
                            FontWeight="Bold"
                            Padding="6,0"
                            Margin="0,0,4,0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            ToolTip="Очистити пошук">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="✕"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Іконка / кнопка пошуку -->
                    <Button x:Name="SearchButton"
                            Grid.Column="2"
                            Click="SearchButton_Click"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="4,0"
                            Cursor="Hand"
                            ToolTip="Шукати">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="🔍"
                                           FontSize="16"
                                           Foreground="#4A3532"
                                           VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Кнопка "Вийти" (повернення в профіль) -->
            <Button Grid.Column="2"
                    x:Name="ExitButton"
                    Click="ExitButton_Click"
                    Background="#4A3532"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="16,8">
                            <TextBlock Text="Назад"
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 2. Підзаголовок: "Мої рецепти" та лічильник результатів -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Мої рецепти"
                           Foreground="#4A3532"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <!-- Лічильник знайдених результатів -->
                <TextBlock x:Name="ResultsCountTextBlock"
                           Foreground="#7A6865"
                           FontSize="13"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- 3. Основний контент: список власних рецептів -->
        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ListBox x:Name="RecipesListBox"
                         SelectionChanged="RecipesListBox_SelectionChanged"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="310"
                                    Background="#877063"
                                    CornerRadius="18"
                                    Padding="15"
                                    Margin="8,6"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="RecipeCard_MouseLeftButtonUp">
                                <StackPanel>
                                    <Border Height="120"
                                            Background="#DDD4C8"
                                            CornerRadius="14"
                                            Margin="0,0,0,10"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Border CornerRadius="14" ClipToBounds="True">
                                                <Image Source="{Binding Photo, Converter={StaticResource BytesToImageConverter}}"
                                                       Stretch="UniformToFill"/>
                                            </Border>

                                            <TextBlock Text="Фото рецепту"
                                                       Foreground="#6B5B54"
                                                       FontSize="15"
                                                       FontWeight="Medium"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Photo}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding Title}"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               TextWrapping="Wrap"
                                               Margin="2,0,0,10"/>

                                    <WrapPanel Margin="0,0,0,2">
                                        <Border Background="#DDD4C8" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding Category}" Foreground="#4A3532" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                        <Border Background="#DDD4C8" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding Cuisine}" Foreground="#4A3532" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                        <Border Background="#DDD4C8" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding Time}" Foreground="#4A3532" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <TextBlock x:Name="EmptyTextBlock"
                       Text="У вас поки немає створених рецептів.&#10;Додайте свій перший рецепт!"
                       TextAlignment="Center"
                       Foreground="#7A6865"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       LineHeight="26"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
