<Window x:Class="FourTaste.WPF.AdminHomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:entities="clr-namespace:FourTaste.ApplicationCore.Entities;assembly=FourTaste.ApplicationCore"
        Title="4taste - Адміністрування" Height="730" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#E5D3BD"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="FilterRadioPillStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7A6865"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#4A3532"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#4A3532"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#DDD4C8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30,16,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="logo.png" Height="48" Width="48" Margin="0,0,8,0" Stretch="Uniform"/>
                <TextBlock Text="4taste"
                           Foreground="#4A3532"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#F4EAE0"
                    BorderBrush="#C4B4A4"
                    BorderThickness="1"
                    CornerRadius="20"
                    Height="42"
                    MaxWidth="560"
                    Margin="30,0"
                    Padding="16,0,12,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SearchPlaceholderTextBlock"
                               Grid.Column="0"
                               Text="Пошук користувача за ім'ям, нікнеймом або поштою..."
                               Foreground="#8A7975"
                               FontSize="14"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Margin="2,0,0,0"/>

                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="0"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#4A3532"
                             FontSize="14"
                             VerticalAlignment="Center"
                             CaretBrush="#4A3532"
                             Padding="0"
                             TextChanged="SearchTextBox_TextChanged"
                             KeyDown="SearchTextBox_KeyDown"/>

                    <Button x:Name="ClearSearchButton"
                            Grid.Column="1"
                            Click="ClearSearchButton_Click"
                            Foreground="#8A7975"
                            FontSize="14"
                            Margin="0,0,4,0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            ToolTip="Очистити пошук">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="✕"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="Bold"
                                           Padding="6,0"
                                           VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="SearchButton"
                            Grid.Column="2"
                            Click="SearchButton_Click"
                            Cursor="Hand"
                            ToolTip="Шукати">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="🔍"
                                           FontSize="16"
                                           Foreground="#4A3532"
                                           Padding="4,0"
                                           VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Button Grid.Column="2"
                    x:Name="ProfileButton"
                    Click="ProfileButton_Click"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="0"
                    Cursor="Hand"
                    ToolTip="Мій профіль">
                <Grid Width="64" Height="64">
                    <Border x:Name="DefaultAvatarBorder"
                            Width="64" Height="64"
                            CornerRadius="32"
                            Background="#EBB832">
                        <TextBlock Text="Мій&#10;профіль"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   Foreground="#4A3532"/>
                    </Border>
                    <Border x:Name="CustomAvatarBorder"
                            Width="64" Height="64"
                            CornerRadius="32"
                            Visibility="Collapsed">
                        <Border.Background>
                            <ImageBrush x:Name="UserAvatarImageBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="Усі користувачі"
                       Foreground="#4A3532"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>

            <Border Background="#F4EAE0" CornerRadius="14" Padding="3" Margin="0,0,12,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FilterAllRadio"
                                 GroupName="UserFilterGroup"
                                 Content="Всі"
                                 IsChecked="True"
                                 Tag="{x:Static entities:UserSearchFilter.All}"
                                 Checked="FilterRadio_Checked"
                                 Style="{StaticResource FilterRadioPillStyle}"/>
                    <RadioButton x:Name="FilterNameRadio"
                                 GroupName="UserFilterGroup"
                                 Content="За ім'ям"
                                 Tag="{x:Static entities:UserSearchFilter.Name}"
                                 Checked="FilterRadio_Checked"
                                 Style="{StaticResource FilterRadioPillStyle}"/>
                    <RadioButton x:Name="FilterUsernameRadio"
                                 GroupName="UserFilterGroup"
                                 Content="За нікнеймом"
                                 Tag="{x:Static entities:UserSearchFilter.Username}"
                                 Checked="FilterRadio_Checked"
                                 Style="{StaticResource FilterRadioPillStyle}"/>
                    <RadioButton x:Name="FilterEmailRadio"
                                 GroupName="UserFilterGroup"
                                 Content="За поштою"
                                 Tag="{x:Static entities:UserSearchFilter.Email}"
                                 Checked="FilterRadio_Checked"
                                 Style="{StaticResource FilterRadioPillStyle}"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ResultsCountTextBlock"
                       Foreground="#7A6865"
                       FontSize="13"
                       FontWeight="Medium"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="UsersItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="310"
                                    Background="#877063"
                                    CornerRadius="18"
                                    Padding="15"
                                    Margin="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Grid.Column="0" Width="64" Height="64" Margin="0,0,12,10" VerticalAlignment="Top">
                                        <Border Width="64" Height="64" CornerRadius="32" Background="#DDD4C8">
                                            <TextBlock Text="{Binding Initial}"
                                                       Foreground="#6B5B54"
                                                       FontSize="26"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="64" Height="64" CornerRadius="32">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding UsernameText}"
                                                   Foreground="#F4EAE0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Email}"
                                                   Foreground="#DDD4C8"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2">
                                        <Border Style="{StaticResource ChipStyle}">
                                            <TextBlock Text="{Binding RecipesText}" Foreground="#4A3532" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                        <Border Style="{StaticResource ChipStyle}">
                                            <TextBlock Text="{Binding RegisteredText}" Foreground="#4A3532" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                        <Border Style="{StaticResource ChipStyle}"
                                                Background="#EBB832"
                                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Адмін" Foreground="#4A3532" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyTextBlock"
                       TextAlignment="Center"
                       Foreground="#7A6865"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       LineHeight="26"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
