<Window x:Class="FourTaste.WPF.CreateRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Р”РѕРґР°С‚Рё РєС–РјРЅР°С‚Сѓ" Height="530" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#EADCC9"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="18" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30,24,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Р”РѕРґР°С‚Рё РєС–РјРЅР°С‚Сѓ"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#4A352F"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,24"/>

        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#B89F8B"
                    CornerRadius="20"
                    Width="320"
                    Height="270"
                    Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="РЎС‚РІРѕСЂРёС‚Рё"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#4A352F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Border Background="#D5C4B4" CornerRadius="10" Padding="10,6" Margin="0,0,0,12">
                            <Grid>
                                <TextBlock x:Name="NamePlaceholder"
                                           Text="Р’РІРµРґС–С‚СЊ РЅР°Р·РІСѓ"
                                           Foreground="#7A685D"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="RoomNameTextBox"
                                         MaxLength="100"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#4A352F"
                                         FontSize="14"
                                         VerticalAlignment="Center"
                                         CaretBrush="#4A352F"
                                         TextChanged="RoomNameTextBox_TextChanged"/>
                            </Grid>
                        </Border>

                        <Border Background="#D5C4B4" CornerRadius="10" Padding="10,6">
                            <Grid>
                                <TextBlock x:Name="DescriptionPlaceholder"
                                           Text="Р”РѕРґР°Р№С‚Рµ РѕРїРёСЃ"
                                           Foreground="#7A685D"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="RoomDescriptionTextBox"
                                         MaxLength="500"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#4A352F"
                                         FontSize="14"
                                         VerticalAlignment="Center"
                                         CaretBrush="#4A352F"
                                         TextChanged="RoomDescriptionTextBox_TextChanged"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Button Grid.Row="2"
                            x:Name="CreateButton"
                            Content="РЎС‚РІРѕСЂРёС‚Рё"
                            Style="{StaticResource RoundedButtonStyle}"
                            Background="#542E2B"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="15"
                            Height="40"
                            Width="180"
                            HorizontalAlignment="Center"
                            Click="CreateButton_Click"/>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#B89F8B"
                    CornerRadius="20"
                    Width="320"
                    Height="270"
                    Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="РЈРІС–Р№С‚Рё"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#4A352F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Border Background="#D5C4B4" CornerRadius="10" Padding="10,6">
                            <Grid>
                                <TextBlock x:Name="CodePlaceholder"
                                           Text="Р’РІРµРґС–С‚СЊ РєРѕРґ"
                                           Foreground="#7A685D"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="JoinCodeTextBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#4A352F"
                                         FontSize="14"
                                         VerticalAlignment="Center"
                                         CaretBrush="#4A352F"
                                         IsEnabled="False"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Button Grid.Row="2"
                            x:Name="JoinButton"
                            Content="РџСЂРёС”РґРЅР°С‚РёСЃСЏ"
                            Style="{StaticResource RoundedButtonStyle}"
                            Background="#542E2B"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="15"
                            Height="40"
                            Width="180"
                            HorizontalAlignment="Center"
                            IsEnabled="False"
                            ToolTip="Р¤СѓРЅРєС†С–СЏ РїСЂРёС”РґРЅР°РЅРЅСЏ РґРѕ РєС–РјРЅР°С‚Рё Р±СѓРґРµ РґРѕСЃС‚СѓРїРЅР° Сѓ РЅР°СЃС‚СѓРїРЅС–Р№ РІРµСЂСЃС–С—"/>
                </Grid>
            </Border>
        </Grid>

        <Button Grid.Row="2"
                x:Name="CancelButton"
                Content="Р’РёР№С‚Рё"
                Style="{StaticResource RoundedButtonStyle}"
                Background="#B89F8B"
                Foreground="#4A352F"
                FontWeight="Bold"
                FontSize="15"
                Height="40"
                Width="160"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Click="CancelButton_Click"/>
    </Grid>
</Window>
