<Window x:Class="FourTaste.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вхід" Height="400" Width="360"
        WindowStartupLocation="CenterScreen"
        Background="#EADCC9"
        ResizeMode="NoResize">
    <Grid Margin="30,20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Вхід" FontSize="26" FontWeight="Bold" Foreground="#4A3532" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                <TextBlock Text="Не маєте облікового запису? " Foreground="#7A6865" FontSize="13"/>
                <Button Content="Зареєструватися" Foreground="#4A3532" FontWeight="Bold" FontSize="13" 
                        Background="Transparent" BorderBrush="Transparent" Cursor="Hand" Click="GoToRegisterButton_Click"/>
            </StackPanel>

            <Border Background="#C4B4A4" CornerRadius="15" Height="45" Padding="15,0" Margin="0,0,0,15">
                <Grid>
                    <TextBox x:Name="EmailTextBox"
                             Background="Transparent" BorderBrush="Transparent" Foreground="#4A3532"
                             VerticalContentAlignment="Center" FontSize="14"
                             TextChanged="EmailTextBox_TextChanged"/>
                    <TextBlock x:Name="EmailPlaceholder"
                               Text="Електронна пошта" Foreground="#7A6865"
                               VerticalAlignment="Center" FontSize="14"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border Background="#C4B4A4" CornerRadius="15" Height="45" Padding="15,0" Margin="0,0,0,25">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="PasswordBox"
                                 Background="Transparent" BorderBrush="Transparent" Foreground="#4A3532"
                                 VerticalContentAlignment="Center" FontSize="14"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <TextBox x:Name="PasswordTextBox"
                             Background="Transparent" BorderBrush="Transparent" Foreground="#4A3532"
                             VerticalContentAlignment="Center" FontSize="14"
                             Visibility="Collapsed"
                             TextChanged="PasswordTextBox_TextChanged"/>

                    <TextBlock x:Name="PasswordPlaceholder"
                               Text="Пароль" Foreground="#7A6865"
                               VerticalAlignment="Center" FontSize="14"
                               IsHitTestVisible="False"/>

                    <Button x:Name="TogglePasswordButton"
                            Grid.Column="1"
                            Width="28" Height="28"
                            Margin="6,0,0,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Cursor="Hand"
                            Focusable="False"
                            ToolTip="Показати пароль"
                            Click="TogglePasswordButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Viewbox Width="17" Height="17" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path x:Name="EyeIcon"
                                      Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                      Fill="#E3D1BD"
                                      Stretch="Uniform"
                                      Visibility="Visible"/>
                                <Path x:Name="EyeSlashIcon"
                                      Data="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"
                                      Fill="#E3D1BD"
                                      Stretch="Uniform"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <Button x:Name="LoginButton" Content="Увійти"
                    Height="35" Width="140"
                    IsDefault="True"
                    Background="#4A3532" Foreground="White" FontWeight="Bold"
                    BorderBrush="Transparent" Click="LoginButton_Click"
                    HorizontalAlignment="Center" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
