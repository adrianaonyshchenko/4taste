<Window x:Class="FourTaste.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вхід" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#DFC7A8">

    <Grid Margin="30">
        <Button x:Name="GoToRegisterButton" Content="Зареєструватися"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="130" Height="30"
                Background="#4A3532" Foreground="White" FontWeight="Bold"
                BorderBrush="Transparent" Click="GoToRegisterButton_Click"
                Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="15"/>
                </Style>
            </Button.Resources>
        </Button>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <Image Source="logo.png" Height="80" Width="100" Margin="0,0,0,15" Stretch="Uniform"/>

            <Border Background="#9C857E" CornerRadius="15" Height="35" Margin="0,0,0,12" Padding="10,0">
                <Grid>
                    <TextBlock Text="Електронна пошта" Foreground="#E3D1BD" VerticalAlignment="Center" IsHitTestVisible="False" Name="EmailPlaceholder"/>
                    <TextBox x:Name="EmailTextBox" Background="Transparent" BorderBrush="Transparent" Foreground="White" VerticalContentAlignment="Center" SelectionBrush="White" TextChanged="EmailTextBox_TextChanged"/>
                </Grid>
            </Border>

            <Border Background="#9C857E" CornerRadius="15" Height="35" Margin="0,0,0,20" Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Пароль" Foreground="#E3D1BD" VerticalAlignment="Center" IsHitTestVisible="False" x:Name="PasswordPlaceholder"/>
                    <PasswordBox Grid.Column="0" x:Name="PasswordBox" Background="Transparent" BorderBrush="Transparent" Foreground="White" VerticalContentAlignment="Center" PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBox Grid.Column="0" x:Name="PasswordTextBox" Background="Transparent" BorderBrush="Transparent" Foreground="White" VerticalContentAlignment="Center" Visibility="Collapsed" TextChanged="PasswordTextBox_TextChanged"/>

                    <Button Grid.Column="1" x:Name="TogglePasswordButton"
                            Click="TogglePasswordButton_Click"
                            Background="Transparent" BorderThickness="0"
                            Padding="4,0" Cursor="Hand" ToolTip="Показати пароль">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Viewbox Width="17" Height="17" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path x:Name="EyeIcon"
                                      Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                      Fill="#E3D1BD"
                                      Stretch="Uniform"
                                      Visibility="Visible"/>
                                <Path x:Name="EyeSlashIcon"
                                      Data="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"
                                      Fill="#E3D1BD"
                                      Stretch="Uniform"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <Button x:Name="LoginButton" Content="Увійти"
                    Height="35" Width="140"
                    Background="#4A3532" Foreground="White" FontWeight="Bold"
                    BorderBrush="Transparent" Click="LoginButton_Click"
                    HorizontalAlignment="Center" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
