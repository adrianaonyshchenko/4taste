<Window x:Class="FourTaste.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вхід" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#E3D1BD">
    <!-- Бежевий фон з макета -->

    <Grid Margin="30">
        <!-- Кнопка «Зареєструватися» у правому верхньому кутку -->
        <Button x:Name="GoToRegisterButton" Content="Зареєструватися"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="130" Height="30"
                Background="#4A3532" Foreground="White" FontWeight="Bold"
                BorderBrush="Transparent" Click="GoToRegisterButton_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="15"/>
                </Style>
            </Button.Resources>
        </Button>

        <!-- Основний блок по центру -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

            <!-- Логотип (або текст/зображення taste) -->
            <!-- Якщо у тебе є файл логотипу у проєкті, можна замінити Image на Source="logo.png" -->
            <Image Source="logo.png" Height="80" Width="100" Margin="0,0,0,15" Stretch="Uniform"/>

            <!-- Поле для Електронної пошти -->
            <Border Background="#9C857E" CornerRadius="15" Height="35" Margin="0,0,0,12" Padding="10,0">
                <Grid>
                    <TextBlock Text="Електронна пошта" Foreground="#E3D1BD" VerticalAlignment="Center" IsHitTestVisible="False" Name="EmailPlaceholder"/>
                    <TextBox x:Name="EmailTextBox" Background="Transparent" BorderBrush="Transparent" Foreground="White" VerticalContentAlignment="Center" SelectionBrush="White"/>
                </Grid>
            </Border>

            <!-- Поле для Пароля -->
            <Border Background="#9C857E" CornerRadius="15" Height="35" Margin="0,0,0,20" Padding="10,0">
                <Grid>
                    <TextBlock Text="Пароль" Foreground="#E3D1BD" VerticalAlignment="Center" IsHitTestVisible="False" Name="PasswordPlaceholder"/>
                    <PasswordBox x:Name="PasswordBox" Background="Transparent" BorderBrush="Transparent" Foreground="White" VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Кнопка «Увійти» -->
            <Button x:Name="LoginButton" Content="Увійти"
                    Height="35" Width="140"
                    Background="#4A3532" Foreground="White" FontWeight="Bold"
                    BorderBrush="Transparent" Click="LoginButton_Click"
                    HorizontalAlignment="Center">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
            </Button>

        </StackPanel>
    </Grid>
</Window>