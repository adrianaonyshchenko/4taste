<Window x:Class="FourTaste.WPF.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Реєстрація - 4taste" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#DFC7A8">

    <Grid Margin="30,20,30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхня панель з кнопкою Увійти -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Button Content="Увійти" 
                    Foreground="#4A3532" 
                    Background="#C4B4A4" 
                    BorderBrush="Transparent" 
                    FontWeight="Bold"
                    FontSize="14"
                    Width="90"
                    Height="32"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    Click="LoginButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Основний вміст -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">

            <Image Source="/logo.png" Width="90" Height="90" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <Border Background="#C4B4A4" CornerRadius="22" Height="45" Padding="15,0" Margin="0,0,0,12">
                <Grid>
                    <TextBox x:Name="NameTextBox" 
                             Background="Transparent" 
                             BorderBrush="Transparent" 
                             Foreground="#4A3532"
                             CaretBrush="#4A3532"
                             VerticalContentAlignment="Center" 
                             FontSize="14"/>
                    <TextBlock Text="Ім'я" 
                               Foreground="#7A6865" 
                               VerticalAlignment="Center" 
                               FontSize="14"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=NameTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Background="#C4B4A4" CornerRadius="22" Height="45" Padding="15,0" Margin="0,0,0,12">
                <Grid>
                    <TextBox x:Name="UsernameTextBox" 
                             Background="Transparent" 
                             BorderBrush="Transparent" 
                             Foreground="#4A3532"
                             CaretBrush="#4A3532"
                             VerticalContentAlignment="Center" 
                             FontSize="14"/>
                    <TextBlock Text="Нікнейм" 
                               Foreground="#7A6865" 
                               VerticalAlignment="Center" 
                               FontSize="14"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=UsernameTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Background="#C4B4A4" CornerRadius="22" Height="45" Padding="15,0" Margin="0,0,0,12">
                <Grid>
                    <TextBox x:Name="EmailTextBox" 
                             Background="Transparent" 
                             BorderBrush="Transparent" 
                             Foreground="#4A3532"
                             CaretBrush="#4A3532"
                             VerticalContentAlignment="Center" 
                             FontSize="14"/>
                    <TextBlock Text="Електронна пошта" 
                               Foreground="#7A6865" 
                               VerticalAlignment="Center" 
                               FontSize="14"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=EmailTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Background="#C4B4A4" CornerRadius="22" Height="45" Padding="15,0" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox Grid.Column="0"
                                 x:Name="PasswordBox" 
                                 Background="Transparent" 
                                 BorderBrush="Transparent" 
                                 Foreground="#4A3532"
                                 CaretBrush="#4A3532"
                                 VerticalContentAlignment="Center" 
                                 FontSize="14"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <TextBox Grid.Column="0"
                             x:Name="PasswordTextBox" 
                             Background="Transparent" 
                             BorderBrush="Transparent" 
                             Foreground="#4A3532"
                             CaretBrush="#4A3532"
                             VerticalContentAlignment="Center" 
                             FontSize="14"
                             Visibility="Collapsed"
                             TextChanged="PasswordTextBox_TextChanged"/>

                    <TextBlock Grid.Column="0"
                               x:Name="PasswordPlaceholder" 
                               Text="Пароль" 
                               Foreground="#7A6865" 
                               VerticalAlignment="Center" 
                               FontSize="14"
                               IsHitTestVisible="False"/>

                    <Button Grid.Column="1" x:Name="TogglePasswordButton"
                            Click="TogglePasswordButton_Click"
                            Background="Transparent" BorderThickness="0"
                            Padding="6,0,2,0" Cursor="Hand" ToolTip="Показати пароль">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Viewbox Width="19" Height="19" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <Path x:Name="EyeIcon"
                                      Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                      Fill="#7A6865"
                                      Stretch="Uniform"
                                      Visibility="Visible"/>
                                <Path x:Name="EyeSlashIcon"
                                      Data="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"
                                      Fill="#7A6865"
                                      Stretch="Uniform"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <Button x:Name="RegisterButton"
                    Content="Зареєструватися" 
                    Foreground="White" 
                    FontWeight="Bold"
                    FontSize="15"
                    Height="45" 
                    Width="360"
                    HorizontalAlignment="Center"
                    Click="RegisterButton_Click"
                    Cursor="Hand"
                    BorderBrush="Transparent">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#4A3532"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
