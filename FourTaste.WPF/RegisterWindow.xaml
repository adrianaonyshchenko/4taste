<Window x:Class="FourTaste.WPF.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Реєстрація - 4taste" Height="680" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#DFC7A8">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="Увійти" 
                Foreground="#5C3A21" 
                Background="Transparent" 
                BorderBrush="Transparent" 
                FontWeight="Bold"
                FontSize="15"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top"
                Cursor="Hand"
                Click="LoginButton_Click"/>

        <Image Grid.Row="1" Source="/logo.png" Width="140" Height="140" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,5,0,15"/>

        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">

            <Border Background="#8C7365" CornerRadius="22" Height="48" Padding="18,0" Margin="0,0,0,12">
                <Grid>
                    <TextBox x:Name="NameTextBox" 
                             Background="Transparent" 
                             BorderBrush="Transparent" 
                             Foreground="#F5EDEA"
                             CaretBrush="#F5EDEA"
                             VerticalContentAlignment="Center" 
                             FontSize="15"/>
                    <TextBlock Text="Ім'я" 
                               Foreground="#D6C5B3" 
                               VerticalAlignment="Center" 
                               FontSize="15"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=NameTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Background="#8C7365" CornerRadius="22" Height="48" Padding="18,0" Margin="0,0,0,12">
                <Grid>
                    <TextBox x:Name="UsernameTextBox" 
                             Background="Transparent" 
                             BorderBrush="Transparent" 
                             Foreground="#F5EDEA"
                             CaretBrush="#F5EDEA"
                             VerticalContentAlignment="Center" 
                             FontSize="15"/>
                    <TextBlock Text="Нікнейм" 
                               Foreground="#D6C5B3" 
                               VerticalAlignment="Center" 
                               FontSize="15"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=UsernameTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Background="#8C7365" CornerRadius="22" Height="48" Padding="18,0" Margin="0,0,0,12">
                <Grid>
                    <TextBox x:Name="EmailTextBox" 
                             Background="Transparent" 
                             BorderBrush="Transparent" 
                             Foreground="#F5EDEA"
                             CaretBrush="#F5EDEA"
                             VerticalContentAlignment="Center" 
                             FontSize="15"/>
                    <TextBlock Text="Електронна пошта" 
                               Foreground="#D6C5B3" 
                               VerticalAlignment="Center" 
                               FontSize="15"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=EmailTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Background="#8C7365" CornerRadius="22" Height="48" Padding="18,0">
                <Grid>
                    <PasswordBox x:Name="PasswordBox" 
                                 Background="Transparent" 
                                 BorderBrush="Transparent" 
                                 Foreground="#F5EDEA"
                                 CaretBrush="#F5EDEA"
                                 VerticalContentAlignment="Center" 
                                 FontSize="15"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBlock x:Name="PasswordPlaceholder" 
                               Text="Пароль" 
                               Foreground="#D6C5B3" 
                               VerticalAlignment="Center" 
                               FontSize="15"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </StackPanel>

        <Button Grid.Row="3" 
                Content="Зареєструватися" 
                Foreground="White" 
                FontWeight="Medium"
                FontSize="15"
                Height="48" 
                Width="340"
                HorizontalAlignment="Center"
                Margin="0,15,0,0"
                Click="RegisterButton_Click"
                Cursor="Hand"
                BorderBrush="Transparent">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#5C3A21"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>