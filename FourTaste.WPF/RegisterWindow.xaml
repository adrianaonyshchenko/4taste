<Window x:Class="FourTaste.WPF.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Реєстрація - 4taste" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#DFC7A8">

    <Grid Margin="30,20,30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхня панель з кнопкою Увійти -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Button Content="Увійти" 
                    Foreground="#4A3532" 
                    Background="#C4B4A4" 
                    BorderBrush="Transparent" 
                    FontWeight="Bold"
                    FontSize="14"
                    Width="90"
                    Height="32"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    Click="LoginButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Основний вміст у вигляді горизонтальних колон або центру -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">

            <Image Source="/logo.png" Width="90" Height="90" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <Border Background="#C4B4A4" CornerRadius="22" Height="45" Padding="15,0" Margin="0,0,0,12">
                <Grid>
                    <TextBox x:Name="NameTextBox" 
                             Background="Transparent" 
                             BorderBrush="Transparent" 
                             Foreground="#4A3532"
                             CaretBrush="#4A3532"
                             VerticalContentAlignment="Center" 
                             FontSize="14"/>
                    <TextBlock Text="Ім'я" 
                               Foreground="#7A6865" 
                               VerticalAlignment="Center" 
                               FontSize="14"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=NameTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Background="#C4B4A4" CornerRadius="22" Height="45" Padding="15,0" Margin="0,0,0,12">
                <Grid>
                    <TextBox x:Name="UsernameTextBox" 
                             Background="Transparent" 
                             BorderBrush="Transparent" 
                             Foreground="#4A3532"
                             CaretBrush="#4A3532"
                             VerticalContentAlignment="Center" 
                             FontSize="14"/>
                    <TextBlock Text="Нікнейм" 
                               Foreground="#7A6865" 
                               VerticalAlignment="Center" 
                               FontSize="14"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=UsernameTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Background="#C4B4A4" CornerRadius="22" Height="45" Padding="15,0" Margin="0,0,0,12">
                <Grid>
                    <TextBox x:Name="EmailTextBox" 
                             Background="Transparent" 
                             BorderBrush="Transparent" 
                             Foreground="#4A3532"
                             CaretBrush="#4A3532"
                             VerticalContentAlignment="Center" 
                             FontSize="14"/>
                    <TextBlock Text="Електронна пошта" 
                               Foreground="#7A6865" 
                               VerticalAlignment="Center" 
                               FontSize="14"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=EmailTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Background="#C4B4A4" CornerRadius="22" Height="45" Padding="15,0" Margin="0,0,0,15">
                <Grid>
                    <PasswordBox x:Name="PasswordBox" 
                                 Background="Transparent" 
                                 BorderBrush="Transparent" 
                                 Foreground="#4A3532"
                                 CaretBrush="#4A3532"
                                 VerticalContentAlignment="Center" 
                                 FontSize="14"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBlock x:Name="PasswordPlaceholder" 
                               Text="Пароль" 
                               Foreground="#7A6865" 
                               VerticalAlignment="Center" 
                               FontSize="14"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Button x:Name="RegisterButton"
                    Content="Зареєструватися" 
                    Foreground="White" 
                    FontWeight="Bold"
                    FontSize="15"
                    Height="45" 
                    Width="360"
                    HorizontalAlignment="Center"
                    Click="RegisterButton_Click"
                    Cursor="Hand"
                    BorderBrush="Transparent">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#4A3532"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>