<Window x:Class="FourTaste.WPF.UserCuisinesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кухні світу" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" Background="#E3D1BD">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Країни / Кухні" HorizontalAlignment="Center" FontWeight="Bold" FontSize="18" Foreground="#4A3532" Margin="0,0,0,15"/>
            <ListBox x:Name="CuisinesListBox" Background="Transparent" BorderBrush="#C4B4A4" Height="330">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="330" Margin="0,6">
                            <TextBlock Text="{Binding CuisineName}" Foreground="#4A3532" FontSize="14" VerticalAlignment="Center" FontWeight="Medium"/>
                            <Border Background="#4A3532" CornerRadius="12" Width="50" Height="26" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Count}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Window>