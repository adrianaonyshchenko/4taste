<Window x:Class="FourTaste.WPF.MealPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="План харчування" Height="580" Width="750"
        WindowStartupLocation="CenterScreen" Background="#E3D1BD">
    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Календар ліворуч (збільшений через LayoutTransform) -->
        <Border Grid.Column="0" Background="#C4B4A4" CornerRadius="22" Padding="15" VerticalAlignment="Top" HorizontalAlignment="Center">
            <Calendar x:Name="MenuCalendar"
                      SelectedDatesChanged="MenuCalendar_SelectedDatesChanged"
                      Background="Transparent"
                      BorderBrush="Transparent">
                <Calendar.LayoutTransform>
                    <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                </Calendar.LayoutTransform>
            </Calendar>
        </Border>

        <!-- Керування стравами обраного дня праворуч -->
        <StackPanel Grid.Column="1" Margin="30,0,0,0">
            <TextBlock x:Name="SelectedDateTextBlock" Text="Обрана дата" FontWeight="Bold" FontSize="18" Foreground="#4A3532" Margin="0,0,0,12"/>

            <TextBox x:Name="RecipeTextBox" Height="36" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12" ToolTip="Введіть назву страви">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <Button x:Name="AddRecipeButton" Content="Зберегти страву" Click="AddRecipeButton_Click" Height="40" Background="#4A3532" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,0,15">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>

            <ListBox x:Name="PlannedRecipesListBox" Height="190" Background="Transparent" BorderBrush="#C4B4A4" Foreground="#4A3532" Margin="0,0,0,15">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <CheckBox IsChecked="{Binding IsCooked, Mode=TwoWay}" 
                          VerticalContentAlignment="Center" 
                          Click="RecipeCheckBox_Click">
                                <TextBlock Text="{Binding RecipeName}" FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#4A3532"/>
                                            <Setter Property="TextDecorations" Value="None"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCooked}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    <Setter Property="Foreground" Value="#8A7975"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </CheckBox>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button x:Name="DeleteRecipeButton" Content="Видалити страву" Click="DeleteRecipeButton_Click" Height="40" Background="#D8B5A8" Foreground="#D9534F" FontWeight="Bold" BorderBrush="Transparent">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>