<Window x:Class="FourTaste.WPF.FavoriteRecipesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обрані рецепти" Height="600" Width="800"
        WindowStartupLocation="CenterScreen" Background="#E3D1BD">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Мої обрані рецепти" FontSize="22" FontWeight="Bold" Foreground="#4A3532" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Список обраних рецептів -->
        <ListBox x:Name="FavoriteRecipesListBox" Grid.Row="1" Background="#F5ECE1" BorderBrush="#C4B4A4" SelectionChanged="FavoriteRecipesListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#C4B4A4" CornerRadius="12" Padding="15" Margin="5" Width="700">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Foreground="#4A3532"/>
                                <TextBlock Text="{Binding Category}" FontSize="13" Foreground="#7A6865" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Time, StringFormat='⏱ {0}'}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4A3532"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Кнопки керування внизу -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Назад до профілю" Click="BackToProfile_Click" Height="36" Width="140" Background="#C4B4A4" Foreground="#4A3532" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,10,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>