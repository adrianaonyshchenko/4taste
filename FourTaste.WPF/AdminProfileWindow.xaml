<Window x:Class="FourTaste.WPF.AdminProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профіль адміністратора" Height="520" Width="760"
        WindowStartupLocation="CenterScreen" Background="#E3D1BD"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#4A3532"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30,25,30,25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Grid Width="70" Height="70" Margin="0,0,12,0">
                    <Border x:Name="DefaultAvatarBorder" Width="70" Height="70" CornerRadius="35" Background="#EBB832">
                        <TextBlock Text="Мій&#10;профіль" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#4A3532"/>
                    </Border>
                    <Border x:Name="CustomAvatarBorder" Width="70" Height="70" CornerRadius="35" Visibility="Collapsed">
                        <Border.Background>
                            <ImageBrush x:Name="UserAvatarImageBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UserNameTextBlock" Text="Ім'я" FontWeight="Bold" FontSize="18" Foreground="#4A3532" TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                    <TextBlock x:Name="UserNicknameTextBlock" Text="Нікнейм" FontSize="14" Foreground="#7A6865" TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                    <Border Background="#EBB832" CornerRadius="10" Padding="10,3" Margin="0,6,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="Адміністратор" FontSize="11" FontWeight="Bold" Foreground="#4A3532"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <Border Background="#C4B4A4" CornerRadius="22" Padding="18,14" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Електронна пошта" Foreground="#4A3532" FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="UserEmailTextBlock" Foreground="#4A3532" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Button x:Name="HomeButton"
                    Click="HomeButton_Click"
                    Content="Головна"
                    Style="{StaticResource RoundedButton}"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="15,0,0,0">
            <TextBlock Text="Керування профілем" Foreground="#4A3532" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

            <Button x:Name="EditDataButton"
                    Click="EditDataButton_Click"
                    Content="Змінити дані"
                    Style="{StaticResource RoundedButton}"/>

            <TextBlock Text="Ім'я, нікнейм, пошта, аватарка та пароль."
                       Foreground="#7A6865"
                       FontSize="12"
                       Margin="4,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="DeleteProfileButton"
                        Click="DeleteProfileButton_Click"
                        Content="Видалити профіль"
                        Style="{StaticResource RoundedButton}"
                        Height="36"
                        Background="#D8B5A8"
                        Foreground="#D9534F"
                        Margin="0,0,10,0"/>
                <Button x:Name="LogoutButton"
                        Click="LogoutButton_Click"
                        Content="Вийти"
                        Style="{StaticResource RoundedButton}"
                        Height="36"
                        Width="90"
                        Background="#C4B4A4"
                        Foreground="#4A3532"
                        Margin="0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
