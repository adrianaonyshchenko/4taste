<Window x:Class="FourTaste.WPF.EditRecipeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редагування рецепту" Height="760" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#EADCC9"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="#D5C4B4"/>
            <Setter Property="Foreground" Value="#4A352F"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="18" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ParamComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#E3D7CB"/>
            <Setter Property="Foreground" Value="#4A352F"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="28"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#B89F8B" CornerRadius="18" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#E3D7CB" CornerRadius="12" ClipToBounds="True">
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ChangePhotoButton_Click"
                                ToolTip="Натисніть, щоб додати або замінити фото">
                            <Grid>
                                <TextBlock x:Name="PhotoPlaceholder" Text="фото" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="#7A685D" FontSize="14"/>
                                <Image x:Name="RecipeImage" Stretch="UniformToFill"/>
                                <Border Background="#66000000" VerticalAlignment="Bottom" Height="26">
                                    <TextBlock Text="📷 Змінити фото" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Button>
                    </Border>

                    <Border Grid.Row="2" Background="#E3D7CB" CornerRadius="12" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Інгредієнти" FontWeight="Bold" FontSize="14"
                                       Foreground="#4A352F" Margin="0,0,0,8"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="IngredientsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           Foreground="{Binding TextColor}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                                                <Border Grid.Column="1" Background="#542E2B" CornerRadius="10"
                                                        Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Amount}" Foreground="White"
                                                               FontSize="12" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Button Grid.Row="2" x:Name="ChangeIngredientsButton" Content="Змінити інгредієнти"
                                    Click="ChangeIngredientsButton_Click"
                                    Style="{StaticResource PillButton}" Background="#542E2B" Foreground="White"
                                    Height="44" Margin="0,12,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#D5C4B4" CornerRadius="8" Padding="2" Margin="0,0,0,12">
                        <Grid>
                            <TextBox x:Name="TitleTextBox" FontSize="20" FontWeight="Bold"
                                     Foreground="#4A352F" Background="Transparent" BorderBrush="Transparent"
                                     Padding="6,4" TextChanged="TitleTextBox_TextChanged"/>
                            <TextBlock x:Name="TitlePlaceholder" Text="Змінити назву" FontSize="20" FontWeight="Bold"
                                       Foreground="#8C7A6D" IsHitTestVisible="False" Margin="10,6,0,0"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Час приготування" Width="140" VerticalAlignment="Center"
                                           Foreground="#4A352F" FontSize="14"/>
                                <Border Background="#E3D7CB" CornerRadius="6" Padding="4">
                                    <TextBox x:Name="TimeTextBox" Text="00:00" Width="60"
                                             Foreground="#4A352F" FontSize="14" FontWeight="SemiBold"
                                             Background="Transparent" BorderBrush="Transparent"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Категорія" Width="140" VerticalAlignment="Center"
                                           Foreground="#4A352F" FontSize="14"/>
                                <ComboBox x:Name="CategoryComboBox" Width="160" Style="{StaticResource ParamComboBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Країна" Width="140" VerticalAlignment="Center"
                                           Foreground="#4A352F" FontSize="14"/>
                                <ComboBox x:Name="CuisineComboBox" Width="160" Style="{StaticResource ParamComboBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <TextBlock Text="Статус" Width="140" VerticalAlignment="Center"
                                           Foreground="#4A352F" FontSize="14"/>
                                <ComboBox x:Name="StatusComboBox" Width="160" Style="{StaticResource ParamComboBoxStyle}">
                                    <ComboBoxItem Content="приватний"/>
                                    <ComboBoxItem Content="публічний"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Width="130">
                            <Border Background="#E3D7CB" CornerRadius="12" Padding="10">
                                <TextBlock x:Name="ServingsTextBlock" Text="1&#10;порція" TextAlignment="Center"
                                           FontSize="20" FontWeight="SemiBold" Foreground="#4A352F"/>
                            </Border>
                            <Button x:Name="ChangePortionsButton" Content="Змінити" Click="ChangePortionsButton_Click"
                                    Style="{StaticResource PillButton}" Background="#542E2B" Foreground="White"
                                    Height="32" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Background="#947A66" CornerRadius="12" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Порядок приготування" FontWeight="Bold" FontSize="14"
                                       Foreground="White" Margin="0,0,0,2"/>

                            <TextBlock Grid.Row="1" Text="Змінити опис" FontSize="12"
                                       Foreground="#EADCC9" Margin="0,0,0,8"/>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="StepsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding StepNumber, StringFormat={}{0}.}"
                                                           FontWeight="Bold" Foreground="White" FontSize="14"
                                                           VerticalAlignment="Top" Margin="0,4,0,0"/>

                                                <Border Grid.Column="1" Background="#A6937C" CornerRadius="8" Padding="6,4">
                                                    <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Foreground="White" Background="Transparent" BorderBrush="Transparent"
                                                             FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"/>
                                                </Border>

                                                <Button Grid.Column="2" Content="✕" Click="DeleteStepButton_Click"
                                                        Tag="{Binding}" Background="#F29B9B" Foreground="#4A352F"
                                                        FontWeight="Bold" Height="24" Width="24" Cursor="Hand"
                                                        Margin="4,0,0,0" VerticalAlignment="Top">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Button Grid.Row="3" x:Name="AddStepButton" Content="+ додати крок"
                                    Click="AddStepButton_Click" Background="Transparent" BorderBrush="Transparent"
                                    Foreground="White" FontWeight="Bold" FontSize="13" Cursor="Hand"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="DeleteButton" Content="Видалити" Click="DeleteButton_Click"
                    Style="{StaticResource PillButton}" Background="#F29B9B" Foreground="#4A352F"
                    Height="44" Width="130"/>

            <Button Grid.Column="2" x:Name="BackButton" Content="Назад" Click="BackButton_Click"
                    Style="{StaticResource PillButton}" Background="#B89F8B" Foreground="#4A352F"
                    Height="44" Width="110" Margin="0,0,12,0"/>

            <Button Grid.Column="3" x:Name="SaveButton" Content="Зберегти" Click="SaveButton_Click"
                    Style="{StaticResource PillButton}" Background="#542E2B" Foreground="White"
                    Height="44" Width="130"/>
        </Grid>
    </Grid>
</Window>
