<Window x:Class="FourTaste.WPF.ManageAllergiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Профіль користувача - 4taste" Height="660" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#DFC7A8"
        Loaded="Window_Loaded">

    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="76" Height="76"
                    CornerRadius="38"
                    Background="#E8AC1A"
                    BorderBrush="#C48C0C"
                    BorderThickness="2"
                    Margin="0,0,18,0">
                <TextBlock Text="Мій&#x0a;профіль"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="#5C3A21"
                           FontSize="13"
                           FontWeight="SemiBold"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="DisplayNameTextBlock"
                           Text="Ім'я"
                           Foreground="#5C3A21"
                           FontSize="17"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="DisplayUsernameTextBlock"
                           Text="Нікнейм"
                           Foreground="#5C3A21"
                           FontSize="15"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <Button Grid.Column="2"
                    x:Name="DeleteProfileButton"
                    Content="Видалити профіль"
                    Foreground="#B92D22"
                    FontSize="14"
                    FontWeight="Medium"
                    Width="195"
                    Height="36"
                    VerticalAlignment="Top"
                    Cursor="Hand"
                    BorderBrush="Transparent"
                    Click="DeleteProfileButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#D69589"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="170"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#AE9E87"
                        CornerRadius="20"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Алергени"
                                   Foreground="#5C3A21"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <Border Grid.Row="1"
                                Background="#8C7365"
                                CornerRadius="16"
                                Height="36"
                                Padding="12,0"
                                Margin="0,0,0,8">
                            <Grid>
                                <TextBox x:Name="AllergenTextBox"
                                         Background="Transparent"
                                         BorderBrush="Transparent"
                                         Foreground="#F5EDEA"
                                         CaretBrush="#F5EDEA"
                                         VerticalContentAlignment="Center"
                                         FontSize="13"/>
                                <TextBlock Text="Додати алерген..."
                                           Foreground="#D6C5B3"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=AllergenTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <ListBox x:Name="AllergiesListBox"
                                 Grid.Row="2"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#B92D22"
                                 FontWeight="Medium"
                                 FontSize="14"
                                 DisplayMemberPath="AllergenName"
                                 Margin="0,0,0,8"/>

                        <Button Grid.Row="3"
                                x:Name="DeleteAllergyButton"
                                Content="Видалити обраний"
                                Foreground="#5C3A21"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                FontSize="12"
                                Height="24"
                                Margin="0,0,0,6"
                                Cursor="Hand"
                                Click="DeleteAllergyButton_Click"/>

                        <Button Grid.Row="4"
                                x:Name="SaveAllergyButton"
                                Content="Зберегти"
                                Foreground="White"
                                FontSize="14"
                                Height="36"
                                Cursor="Hand"
                                BorderBrush="Transparent"
                                Click="SaveAllergyButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#5C3A21"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="#AE9E87"
                        CornerRadius="20"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Країни"
                                   Foreground="#5C3A21"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Українська" Foreground="#5C3A21" FontSize="14" VerticalAlignment="Center"/>
                            <Border Background="#5C3A21" CornerRadius="9" Width="40" Height="20" HorizontalAlignment="Right">
                                <TextBlock Text="1" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Італійська" Foreground="#5C3A21" FontSize="14" VerticalAlignment="Center"/>
                            <Border Background="#5C3A21" CornerRadius="9" Width="40" Height="20" HorizontalAlignment="Right">
                                <TextBlock Text="3" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="0,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#AE9E87"
                        CornerRadius="20"
                        Padding="22,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Особисті дані та безпека"
                                   Foreground="#5C3A21"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,14"/>

                        <TextBlock Text="Ім'я" Foreground="#5C3A21" FontSize="13" Margin="6,0,0,4"/>
                        <Border Background="#8C7365" CornerRadius="16" Height="38" Padding="14,0" Margin="0,0,0,10">
                            <TextBox x:Name="ProfileNameTextBox"
                                     Background="Transparent"
                                     BorderBrush="Transparent"
                                     Foreground="#F5EDEA"
                                     CaretBrush="#F5EDEA"
                                     VerticalContentAlignment="Center"
                                     FontSize="14"/>
                        </Border>

                        <TextBlock Text="Нікнейм" Foreground="#5C3A21" FontSize="13" Margin="6,0,0,4"/>
                        <Border Background="#8C7365" CornerRadius="16" Height="38" Padding="14,0" Margin="0,0,0,10">
                            <TextBox x:Name="ProfileUsernameTextBox"
                                     Background="Transparent"
                                     BorderBrush="Transparent"
                                     Foreground="#F5EDEA"
                                     CaretBrush="#F5EDEA"
                                     VerticalContentAlignment="Center"
                                     FontSize="14"/>
                        </Border>

                        <TextBlock Text="Електронна пошта" Foreground="#5C3A21" FontSize="13" Margin="6,0,0,4"/>
                        <Border Background="#8C7365" CornerRadius="16" Height="38" Padding="14,0" Margin="0,0,0,12">
                            <TextBox x:Name="ProfileEmailTextBox"
                                     Background="Transparent"
                                     BorderBrush="Transparent"
                                     Foreground="#F5EDEA"
                                     CaretBrush="#F5EDEA"
                                     VerticalContentAlignment="Center"
                                     FontSize="14"/>
                        </Border>

                        <Button x:Name="UpdateProfileButton"
                                Content="Зберегти особисті дані"
                                Foreground="White"
                                FontSize="14"
                                Height="38"
                                Margin="0,0,0,16"
                                Cursor="Hand"
                                BorderBrush="Transparent"
                                Click="UpdateProfileButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#5C3A21"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Text="Новий пароль" Foreground="#5C3A21" FontSize="13" Margin="6,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#8C7365" CornerRadius="16" Height="38" Padding="14,0" Margin="0,0,8,0">
                                <PasswordBox x:Name="NewPasswordBox"
                                             Background="Transparent"
                                             BorderBrush="Transparent"
                                             Foreground="#F5EDEA"
                                             CaretBrush="#F5EDEA"
                                             VerticalContentAlignment="Center"
                                             FontSize="14"/>
                            </Border>
                            <Button Grid.Column="1"
                                    x:Name="ChangePasswordButton"
                                    Content="Змінити пароль"
                                    Foreground="White"
                                    FontSize="13"
                                    Height="38"
                                    Cursor="Hand"
                                    BorderBrush="Transparent"
                                    Click="ChangePasswordButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#5C3A21"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Grid.Row="1"
                        Content="Мої продукти"
                        Foreground="White"
                        FontSize="16"
                        Height="44"
                        Width="290"
                        HorizontalAlignment="Center"
                        Cursor="Hand"
                        BorderBrush="Transparent">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#5C3A21"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="210"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#AE9E87"
                        CornerRadius="20"
                        Padding="16"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="4 вересня"
                                   Foreground="#5C3A21"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="✓ Рецепт" Foreground="#5C3A21" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Text="• Рецепт" Foreground="#5C3A21" FontSize="14"/>
                        </StackPanel>
                        <Button Grid.Row="2"
                                Content="Змінити"
                                Foreground="White"
                                FontSize="14"
                                Height="34"
                                BorderBrush="Transparent">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#5C3A21"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="17">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="Мої списки"
                               Foreground="#5C3A21"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="4,0,0,10"/>
                    <Border Background="#5C3A21" CornerRadius="20" Height="42" Margin="0,0,0,10">
                        <TextBlock Text="Список 1" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="#5C3A21" CornerRadius="20" Height="42">
                        <TextBlock Text="Список 1" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <Button Grid.Row="2"
                        x:Name="LogoutButton"
                        Content="Вийти"
                        Foreground="#5C3A21"
                        FontSize="15"
                        FontWeight="Medium"
                        Width="135"
                        Height="40"
                        HorizontalAlignment="Right"
                        Cursor="Hand"
                        BorderBrush="Transparent"
                        Click="LogoutButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#9A8975"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
