<Window x:Class="FourTaste.WPF.AdminCategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="4taste - Категорії рецептів" Height="640" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#E5D3BD"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#4A3532"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#C4B4A4"/>
            <Setter Property="Foreground" Value="#4A3532"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#B84A39"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Категорії рецептів"
                           Foreground="#4A3532"
                           FontSize="24"
                           FontWeight="Bold"/>
                <TextBlock x:Name="CountTextBlock"
                           Foreground="#7A6865"
                           FontSize="13"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    x:Name="AddCategoryButton"
                    Content="+ Нова категорія"
                    Background="#EBB832"
                    Foreground="#4A3532"
                    FontWeight="Bold"
                    Style="{StaticResource ActionButton}"
                    Click="AddCategoryButton_Click"/>
        </Grid>

        <Border Grid.Row="1"
                Background="#F4EAE0"
                BorderBrush="#C4B4A4"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14,10"
                Margin="0,0,0,14">
            <TextBlock Text="Керуйте категоріями каталогу: додавайте нові, перейменовуйте існуючі (назва оновиться у рецептах) або видаляйте порожні категорії."
                       Foreground="#7A6865"
                       FontSize="13"
                       TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="CategoriesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#877063"
                                    CornerRadius="16"
                                    Padding="16,12"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding RecipesCountText}"
                                                   Foreground="#F4EAE0"
                                                   FontSize="12"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="Перейменувати"
                                            Style="{StaticResource SecondaryButton}"
                                            Background="#F4EAE0"
                                            Margin="10,0,8,0"
                                            Click="RenameCategoryButton_Click"/>

                                    <Button Grid.Column="2"
                                            Content="Видалити"
                                            Style="{StaticResource DangerButton}"
                                            Click="DeleteCategoryButton_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyTextBlock"
                       Text="Категорій поки немає. Натисніть «+ Нова категорія», щоб додати першу."
                       TextAlignment="Center"
                       Foreground="#7A6865"
                       FontSize="15"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>

        <Button Grid.Row="3"
                x:Name="BackButton"
                Content="Назад"
                Style="{StaticResource SecondaryButton}"
                Width="140"
                HorizontalAlignment="Left"
                Margin="0,14,0,0"
                Click="BackButton_Click"/>
    </Grid>
</Window>
 
