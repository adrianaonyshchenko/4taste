<Window x:Class="FourTaste.WPF.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мій профіль" Height="730" Width="850"
        WindowStartupLocation="CenterScreen" Background="#E3D1BD">
    <Grid Margin="30,25,30,25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Ліва колонка: Аватар, Алергени, Кухні світу -->
        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Grid Width="70" Height="70" Margin="0,0,12,0">
                    <Border x:Name="DefaultAvatarBorder" Width="70" Height="70" CornerRadius="35" Background="#EBB832">
                        <TextBlock Text="Мій&#10;профіль" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#4A3532"/>
                    </Border>
                    <Border x:Name="CustomAvatarBorder" Width="70" Height="70" CornerRadius="35" Visibility="Collapsed">
                        <Border.Background>
                            <ImageBrush x:Name="UserAvatarImageBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UserNameTextBlock" Text="Ім'я" FontWeight="Bold" FontSize="18" Foreground="#4A3532"/>
                    <TextBlock x:Name="UserNicknameTextBlock" Text="Нікнейм" FontSize="14" Foreground="#7A6865"/>
                </StackPanel>
            </StackPanel>

            <Border Background="#C4B4A4" CornerRadius="22" Height="220" Margin="0,0,0,15" Padding="15,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Алергени" HorizontalAlignment="Center" Foreground="#4A3532" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
                    <Border Grid.Row="1" Background="#E3D1BD" CornerRadius="10" Height="28" Padding="6,0" Margin="0,0,0,4">
                        <TextBox x:Name="AllergenTextBox" Background="Transparent" BorderBrush="Transparent" VerticalContentAlignment="Center" FontSize="12" KeyDown="AllergenTextBox_KeyDown"/>
                    </Border>
                    <ListBox x:Name="AllergiesListBox" Grid.Row="2" Background="Transparent" BorderBrush="Transparent" Foreground="#D9534F" FontWeight="Bold" FontSize="12" DisplayMemberPath="AllergenName"/>
                    <Button x:Name="DeleteAllergyButton" Grid.Row="3" Click="DeleteAllergyButton_Click" Content="Видалити обраний" Height="24" Background="Transparent" Foreground="#D9534F" FontWeight="SemiBold" FontSize="12" BorderBrush="Transparent" Cursor="Hand" Margin="0,0,0,6"/>
                    <Button x:Name="SaveAllergensButton" Grid.Row="4" Click="SaveAllergensButton_Click" Content="Зберегти алерген" Height="28" Background="#4A3532" Foreground="White" FontWeight="Bold" BorderBrush="Transparent">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <Border Background="#C4B4A4" CornerRadius="22" Height="150" Padding="15,12" Cursor="Hand" MouseLeftButtonUp="CuisinesBlock_Click">
                <StackPanel>
                    <TextBlock Text="Кухні світу" HorizontalAlignment="Center" Foreground="#4A3532" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock Text="Натисніть, щоб переглянути статистику приготованих рецептів за кухнями (країнами)." TextWrapping="Wrap" TextAlignment="Center" Foreground="#4A3532" FontSize="12" Margin="0,0,0,10"/>
                    <Button Content="Відкрити кухні" Click="OpenCuisinesButton_Click" Height="32" Background="#4A3532" Foreground="White" FontWeight="Bold" BorderBrush="Transparent">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="14"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Права колонка: Керування профілем, списки та розділи -->
        <StackPanel Grid.Column="1" Margin="15,0,0,0">
            <TextBlock Text="Керування профілем" Foreground="#4A3532" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

            <Button x:Name="EditDataButton" Click="EditDataButton_Click" Content="Змінити дані" Height="40" Background="#4A3532" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,0,10">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button x:Name="OpenMealPlanButton" Click="OpenMealPlanButton_Click" Content="Календар харчування на день" Height="42" Background="#4A3532" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,0,20">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>

            <TextBlock Text="Мої списки та розділи" Foreground="#4A3532" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

            <Button x:Name="MyFridgeButton" Click="MyFridgeButton_Click" Content="Мої продукти" Height="40" Background="#4A3532" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" BorderBrush="Transparent">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button x:Name="CookingHistoryButton" Click="CookingHistoryButton_Click" Content="Історія готування" Height="40" Background="#4A3532" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" BorderBrush="Transparent">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button x:Name="MyRecipesButton" Click="MyRecipesButton_Click" Content="Мої рецепти" Height="40" Background="#4A3532" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" BorderBrush="Transparent">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- НОВА КНОПКА: Обрані рецепти (UC-34) -->
            <Button x:Name="FavoriteRecipesButton" Click="FavoriteRecipesButton_Click" Content="Обрані рецепти" Height="40" Background="#4A3532" Foreground="White" FontWeight="Bold" Margin="0,0,0,20" BorderBrush="Transparent">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Нижні кнопки виходу / видалення -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="DeleteProfileButton" Click="DeleteProfileButton_Click" Content="Видалити профіль" Height="36" Width="140" Background="#D8B5A8" Foreground="#D9534F" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,10,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="LogoutButton" Click="LogoutButton_Click" Content="Вийти" Height="36" Width="90" Background="#C4B4A4" Foreground="#4A3532" FontWeight="Bold" BorderBrush="Transparent">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>