<Window x:Class="FourTaste.WPF.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мій профіль" Height="730" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#E3D1BD">
    <Window.Resources>
        <Style TargetType="Calendar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Calendar">
                        <StackPanel x:Name="PART_Root" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <CalendarItem x:Name="PART_CalendarItem"
                                         Background="{TemplateBinding Background}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="{TemplateBinding BorderThickness}"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CalendarItem">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarItem">
                        <Grid x:Name="PART_Root">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="5,0,5,10">
                                <Button x:Name="PART_HeaderButton"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="#4A3532"
                                        Background="Transparent"
                                        BorderBrush="Transparent"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="PART_PreviousButton" Content="&lt;" Width="25" Height="25" Background="Transparent" BorderBrush="Transparent" Foreground="#4A3532" FontSize="14" Margin="0,0,5,0"/>
                                    <Button x:Name="PART_NextButton" Content="&gt;" Width="25" Height="25" Background="Transparent" BorderBrush="Transparent" Foreground="#4A3532" FontSize="14"/>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="PART_MonthView" Grid.Row="1" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                            </Grid>

                            <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CalendarDayButton">
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#4A3532"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border x:Name="DayBorder"
                                Background="Transparent"
                                BorderBrush="#B5A393"
                                BorderThickness="0.6"
                                Margin="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="#E3D1BD"/>
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="#4A3532"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="#D8C4B2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30,25,30,25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Width="70" Height="70" CornerRadius="35" Background="#EBB832" Margin="0,0,12,0">
                    <TextBlock Text="Мій&#10;профіль" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#4A3532"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UserNameTextBlock" Text="Ім'я" FontWeight="Bold" FontSize="18" Foreground="#4A3532"/>
                    <TextBlock Text="Нікнейм" FontSize="14" Foreground="#7A6865"/>
                </StackPanel>
            </StackPanel>

            <Border Background="#C4B4A4" CornerRadius="22" Height="185" Margin="0,0,0,20" Padding="15">
                <Grid>
                    <TextBlock Text="Алергени" HorizontalAlignment="Center" Foreground="#4A3532" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="Алерген" Foreground="#D9534F" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="15"/>
                    <Button x:Name="SaveAllergensButton" Click="SaveAllergensButton_Click" Content="Зберегти" VerticalAlignment="Bottom" Height="35" Background="#4A3532" Foreground="White" FontWeight="Bold" BorderBrush="Transparent">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="14"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <Border Background="#C4B4A4" CornerRadius="22" Height="195" Padding="15">
                <StackPanel>
                    <TextBlock Text="Країни" HorizontalAlignment="Center" Foreground="#4A3532" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Країна" Foreground="#4A3532" FontSize="14" VerticalAlignment="Center"/>
                        <Border Background="#4A3532" CornerRadius="12" Width="45" Height="26" HorizontalAlignment="Right">
                            <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Країна" Foreground="#4A3532" FontSize="14" VerticalAlignment="Center"/>
                        <Border Background="#4A3532" CornerRadius="12" Width="45" Height="26" HorizontalAlignment="Right">
                            <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Background="#C4B4A4" CornerRadius="22" Width="330" Padding="15,10" Margin="0,0,0,20">
                <Calendar x:Name="MenuCalendar"
                  SelectedDatesChanged="MenuCalendar_SelectedDatesChanged"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="12"/>
            </Border>

            <Button x:Name="MyProductsButton" Click="MyProductsButton_Click" Content="Мої продукти" Width="330" Height="48" Background="#4A3532" Foreground="White" FontWeight="Bold" FontSize="16" BorderBrush="Transparent">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="24"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="15,0,0,0">
            <Button x:Name="DeleteProfileButton" Click="DeleteProfileButton_Click" Content="Видалити профіль" Height="38" Background="#D8B5A8" Foreground="#D9534F" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,0,10">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button x:Name="EditDataButton" Click="EditDataButton_Click" Content="Змінити дані" Height="38" Background="#4A3532" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,0,20">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Border Background="#C4B4A4" CornerRadius="22" Height="265" Margin="0,0,0,20" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SelectedDateTextBlock" Grid.Row="0" Text="4 вересня" HorizontalAlignment="Center" Foreground="#4A3532" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>

                    <TextBox x:Name="RecipeTextBox" Grid.Row="1" Height="32" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,8" ToolTip="Введіть назву страви"/>

                    <ListBox x:Name="PlannedRecipesListBox" Grid.Row="2" Background="Transparent" BorderBrush="Transparent" Foreground="#4A3532" Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <CheckBox IsChecked="{Binding IsCooked, Mode=TwoWay}"
                                              VerticalContentAlignment="Center"
                                              Click="RecipeCheckBox_Click">
                                        <TextBlock Text="{Binding RecipeName}" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#4A3532"/>
                                                    <Setter Property="TextDecorations" Value="None"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCooked}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Foreground" Value="#8A7975"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </CheckBox>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button x:Name="AddRecipeButton" Grid.Row="3" Content="Зберегти страву" Click="AddRecipeButton_Click" Height="35" Background="#4A3532" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,0,6">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="14"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Нова кнопка видалення страви -->
                    <Button x:Name="DeleteRecipeButton" Grid.Row="4" Content="Видалити страву" Click="DeleteRecipeButton_Click" Height="35" Background="#D8B5A8" Foreground="#D9534F" FontWeight="Bold" BorderBrush="Transparent">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="14"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <TextBlock Text="Мої списки" Foreground="#4A3532" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
            <Button x:Name="List1Button" Click="List1Button_Click" Content="Список 1" Height="42" Background="#4A3532" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" BorderBrush="Transparent">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="18"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button x:Name="List2Button" Click="List2Button_Click" Content="Список 2" Height="42" Background="#4A3532" Foreground="White" FontWeight="Bold" Margin="0,0,0,20" BorderBrush="Transparent">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="18"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button x:Name="LogoutButton" Click="LogoutButton_Click" Content="Вийти" Height="36" Width="110" Background="#C4B4A4" Foreground="#4A3532" FontWeight="Bold" HorizontalAlignment="Right" BorderBrush="Transparent">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>